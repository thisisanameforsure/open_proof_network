private theorem e_nonneg (n : ℕ) : (0 : ℝ) ≤ 1 / ((2 : ℝ) ^ n - 1) := by
  apply div_nonneg zero_le_one
  have : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
  linarith

private theorem e_le (n : ℕ) : (1 : ℝ) / ((2 : ℝ) ^ n - 1) ≤ 2 * (1 / 2 : ℝ) ^ n := by
  rcases n with _ | n
  · norm_num
  · have h1 : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
    have h2 : (2 : ℝ) ^ n ≤ 2 ^ (n + 1) - 1 := by rw [pow_succ]; linarith
    have h3 : (0 : ℝ) < 2 ^ n := by positivity
    calc (1 : ℝ) / ((2 : ℝ) ^ (n + 1) - 1) ≤ 1 / 2 ^ n := one_div_le_one_div_of_le h3 h2
      _ = 2 * (1 / 2 : ℝ) ^ (n + 1) := by rw [pow_succ, one_div_pow]; ring

private theorem e_summable : Summable (fun n : ℕ => (1 : ℝ) / ((2 : ℝ) ^ n - 1)) :=
  Summable.of_nonneg_of_le e_nonneg e_le (summable_geometric_two.mul_left 2)

private theorem tail_summable (m : ℕ) :
    Summable (fun k : ℕ => (1 : ℝ) / ((2 : ℝ) ^ (k + m) - 1)) :=
  (summable_nat_add_iff m).mpr e_summable

private theorem tail_succ (m : ℕ) :
    ∑' k : ℕ, (1 : ℝ) / ((2 : ℝ) ^ (k + m) - 1) =
      1 / ((2 : ℝ) ^ m - 1) + ∑' k : ℕ, (1 : ℝ) / ((2 : ℝ) ^ (k + (m + 1)) - 1) := by
  rw [(tail_summable m).tsum_eq_zero_add]
  simp only [zero_add]
  congr 1
  apply tsum_congr
  intro k
  rw [show k + 1 + m = k + (m + 1) by ring]

private theorem e_le_tail (m : ℕ) :
    (1 : ℝ) / ((2 : ℝ) ^ m - 1) ≤ ∑' k : ℕ, (1 : ℝ) / ((2 : ℝ) ^ (k + m) - 1) := by
  rw [tail_succ]
  have : 0 ≤ ∑' k : ℕ, (1 : ℝ) / ((2 : ℝ) ^ (k + (m + 1)) - 1) :=
    tsum_nonneg (fun k => e_nonneg _)
  linarith

