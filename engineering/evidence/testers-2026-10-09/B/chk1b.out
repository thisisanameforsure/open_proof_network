   "content": "import Mathlib\n\n-- inlined by the network from Nodes.«erdos-1094--h2».Context (F13-R5)\n/-! Declared dependencies (D-4 step 8): `erdos-1094--h2--h1`, `erdos-1094--h2--h2`. -/\n\nopen scoped Nat\n\n/-! Hole `h_lo` of a merged partial proof, as a node (D-12 #5, D-29).\nStatement generated by the gate from the assembly; immutable (D-3). -/\n\ntheorem erdos_1094__h2__h1 : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → k * k ≤ n → n < k * k * k → (n.choose k).minFac > n / k → k ≤ K := by\n  sorry\n\n\nopen scoped Nat\n\n/-! Hole `h_hi` of a merged partial proof, as a node (D-12 #5, D-29).\nStatement generated by the gate from the assembly; immutable (D-3). -/\n\ntheorem erdos_1094__h2__h2 : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → k * k * k ≤ n → (n.choose k).minFac > n / k → k ≤ K := by\n  sorry\n\n\nopen scoped Nat\n\n/-! Hole `h_large_n` of a merged partial proof, as a node (D-12 #5, D-29).\nStatement generated by the gate from the assembly; immutable (D-3). -/\n\ntheorem erdos_1094__h2 : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → k * k ≤ n → (n.choose k).minFac > n / k → k ≤ K := by\n  have hall : (∃ K : ℕ, ∀ n k : ℕ, 0 < k → k * k ≤ n → n < k * k * k →\n        (n.choose k).minFac > n / k → k ≤ K) ∧\n      (∃ K : ℕ, ∀ n k : ℕ, 0 < k → k * k * k ≤ n →\n        (n.choose k).minFac > n / k → k ≤ K) := by\n    refine ⟨?_, ?_⟩\n    · have h_lo : ∃ K : ℕ, ∀ n k : ℕ, 0 < k → k * k ≤ n → n < k * k * k →\n          (n.choose k).minFac > n / k → k ≤ K := by sorry\n      exact h_lo\n    · have h_hi : ∃ K : ℕ, ∀ n k : ℕ, 0 < k → k * k * k ≤ n →\n          (n.choose k).minFac > n / k → k ≤ K := by sorry\n      exact h_hi\n  obtain ⟨⟨K₁, hK₁⟩, ⟨K₂, hK₂⟩⟩ := hall\n  refine ⟨max K₁ K₂, fun n k hk hn hex => ?_⟩\n  by_cases hc : n < k * k * k\n  · exact le_trans (hK₁ n k hk hn hc hex) (le_max_left _ _)\n  · exact le_trans (hK₂ n k hk (Nat.le_of_not_lt hc) hex) (le_max_right _ _)\n\n",
