    have ha0 : a ≠ 0 := fun h => h0 (h ▸ ha)
    have hg0 : 0 < a.gcd b := Nat.gcd_pos_of_pos_left b (Nat.pos_of_ne_zero ha0)
    obtain ⟨x, hx⟩ := Nat.gcd_dvd_left a b
    have hpg : ¬ p ∣ a.gcd b := fun h => hpb (h.trans (Nat.gcd_dvd_right a b))
    have hpx : p ∣ x := by
      have h1 : p ∣ a.gcd b * x := hx ▸ hpa
      exact (hp.dvd_mul.mp h1).resolve_left hpg
    obtain ⟨t, ht⟩ := hpx
    have hlt' := hlt a ha b hb
    have hxn : x < B.card := by
      have h3 : a.gcd b * x < a.gcd b * B.card := by
        rw [← hx, Nat.mul_comm]; exact hlt'
      exact Nat.lt_of_mul_lt_mul_left h3
    have ht1 : t = 1 := by
      have hx0 : x ≠ 0 := by
        rintro rfl
        rw [Nat.mul_zero] at hx
        exact ha0 hx
      have ht0 : t ≠ 0 := by
        rintro rfl
        rw [Nat.mul_zero] at ht
        exact hx0 ht
      by_contra hne1
      have ht2 : 2 ≤ t := by omega
      have h4 : p * 2 ≤ p * t := Nat.mul_le_mul_left p ht2
      omega
    rw [hx, ht, ht1, Nat.mul_one, Nat.mul_comm]
  by_cases hex : ∃ p : ℕ, p.Prime ∧ B.card ≤ 2 * p ∧ ∃ a ∈ B, p ∣ a
  · obtain ⟨p, hp, hnp2, a, ha, hpa⟩ := hex
    have hpn : p < B.card := by
      have h1 := hpp a ha p 1 hp (by rwa [pow_one])
      rwa [pow_one] at h1
    have hexb : ∃ b ∈ B, ¬ p ∣ b := by
