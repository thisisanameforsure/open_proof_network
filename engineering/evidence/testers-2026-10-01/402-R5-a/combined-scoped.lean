    generalize Nat.gcd α d2 = e2 at *
    generalize Nat.gcd β d1 = f1 at *
    generalize Nat.gcd β d2 = f2 at *
    generalize Nat.gcd (α * d1) (β * d2) = G at *
    generalize Nat.gcd (β * d1) (α * d2) = G' at *
