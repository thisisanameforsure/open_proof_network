  have R3c_no_prime_of_kernel : ∀ (B : Finset ℕ) (h0 : 0 ∉ B) (hgcd : B.gcd id = 1) (hlt : ∀ a ∈ B, ∀ b ∈ B, a < B.card * a.gcd b) (p k M : ℕ) (hp : p.Prime) (hM0 : 0 < M) (hM : ∀ m : ℕ, 0 < m → m ≤ k → m ∣ M) (hk : B.card ≤ (k + 1) * p) (hK : ∀ X S : Finset ℕ, X.Nonempty → S.Nonempty → (∀ x ∈ X, 0 < x) → (∀ s ∈ S, 0 < s) → (∀ s ∈ S, ¬ p ∣ s) → (∀ x ∈ X, ∀ x' ∈ X, x < B.card * Nat.gcd x x') → (∀ s ∈ S, ∀ t ∈ S, s < B.card * Nat.gcd s t) → (∀ x ∈ X, ∀ s ∈ S, ∃ m y : ℕ, 0 < m ∧ m ≤ k ∧ y < B.card ∧ ¬ p ∣ y ∧ Nat.Coprime m y ∧ x * s * m = M * y) → X.card + S.card < B.card),
