        (∀ x ∈ X, 0 < x) → (∀ s ∈ S, 0 < s) → (∀ s ∈ S, ¬ p ∣ s) →
        (∀ x ∈ X, ∀ x' ∈ X, x < n * Nat.gcd x x') →
        (∀ s ∈ S, ∀ t ∈ S, s < n * Nat.gcd s t) →
