  -- (L-) and they vanish in negative degree above minus the number of nodes
  have hV : ∀ m : ℕ, ∀ s : Finset ℕ, m + 1 < s.card → ∑ k ∈ s, (((2 : ℝ) ^ k) ^ (m + 1))⁻¹ / ∏ l ∈ s.erase k, (1 - (2 : ℝ) ^ ((l : ℤ) - (k : ℤ))) = 0 := by
