theorem variant_3969f1f7__h2__h1__h4__h2__h3 : ∀ (n k m l : ℕ),
  (2 : ℕ) ≤ k →
    (2 : ℕ) * k ≤ n →
      (2 : ℕ) ≤ l →
        (2 : ℕ) * l ≤ m →
          k < l →
            n.choose k = m.choose l →
              (k = (2 : ℕ) ∧ l = (3 : ℕ) ∨
