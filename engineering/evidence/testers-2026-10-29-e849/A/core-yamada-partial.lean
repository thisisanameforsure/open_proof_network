                            k = (3 : ℕ) ∧ l = (6 : ℕ) ∨ k = (4 : ℕ) ∧ l = (6 : ℕ) ∨ k = (4 : ℕ) ∧ l = (8 : ℕ)) ∨
                m + (1 : ℕ) = n ∧ l = k + (1 : ℕ) ∨
                  n ≤ (1000000 : ℕ) ∨
                    n.choose k ≤ (10 : ℕ) ^ (60 : ℕ) ∨
                      m + (1 : ℕ) = n ∧ l = k + (2 : ℕ) ∨ m + (2 : ℕ) = n ∧ l = k + (1 : ℕ) := by
  -- approach: set aside the interior window where Yamada 2020 (arXiv:2002.07043, Theorem 1.1) rules collisions out; the rest of the core is left as it stands
  -- licence: CC-BY-4.0
  -- label: Yamada 2020, Theorem 1.1, case L ≤ N
  -- claim: $N \ge 500000,\ \delta \le 1,\ M < K,\ 2K < N,\ 1000M \le 735K,\ \delta < L \le N \implies \tbinom{2N+\delta}{N-M} \ne \tbinom{2N+L}{N-K}$
  -- T. Yamada, Necessary conditions for binomial collisions, arXiv:2002.07043 (2020), Theorem 1.1:
  -- a collision C(2N+δ, N−M) = C(2N+L, N−K) with δ ∈ {0,1}, L > δ, 0 ≤ M < K < N/2 and
  -- M ≤ 0.735K has L > N(1.3132 log²(2N) − 2.00271). The proof assumes N ≥ 500000, which it takes
  -- from Blokhuis–Brouwer–de Weger 2017; at N ≥ 500000 the bound exceeds N, so L ≤ N is excluded.
  have h_yamada : ∀ N δ M K L : ℕ, 500000 ≤ N → δ ≤ 1 → M < K → 2 * K < N → 1000 * M ≤ 735 * K →
      δ < L → L ≤ N → (2 * N + δ).choose (N - M) ≠ (2 * N + L).choose (N - K) := sorry
  -- label: the open core outside Yamada's window
  -- claim: $\tbinom{n}{k} = \tbinom{m}{l},\ 2 \le k \le n/2,\ 2 \le l \le m/2,\ k < l \implies \text{(the core's cases)} \vee \big(N \ge 500000 \wedge N < 2k \wedge 1000(N - l) \le 735(N - k) \wedge m < n \le 3N\big),\ N = \lfloor m/2 \rfloor$
  -- The parent's statement with one more case set aside: with N = ⌊m/2⌋, the collisions where the
  -- larger index l and the smaller index k both lie in Yamada's window (in his notation
  -- M = N − l, K = N − k, L = n − 2N) and n ≤ 3N.
  have h_rest : ∀ (n k m l : ℕ), 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l →
      n.choose k = m.choose l →
        ((k = (2 : ℕ) ∧ l = (3 : ℕ) ∨ k = (2 : ℕ) ∧ l = (4 : ℕ) ∨ k = (2 : ℕ) ∧ l = (5 : ℕ) ∨ k = (2 : ℕ) ∧ l = (6 : ℕ) ∨ k = (2 : ℕ) ∧ l = (8 : ℕ) ∨ k = (3 : ℕ) ∧ l = (4 : ℕ) ∨ k = (3 : ℕ) ∧ l = (6 : ℕ) ∨ k = (4 : ℕ) ∧ l = (6 : ℕ) ∨ k = (4 : ℕ) ∧ l = (8 : ℕ)) ∨ m + (1 : ℕ) = n ∧ l = k + (1 : ℕ) ∨ n ≤ (1000000 : ℕ) ∨ n.choose k ≤ (10 : ℕ) ^ (60 : ℕ) ∨ m + (1 : ℕ) = n ∧ l = k + (2 : ℕ) ∨ m + (2 : ℕ) = n ∧ l = k + (1 : ℕ)) ∨
          (500000 ≤ m / 2 ∧ m / 2 < 2 * k ∧ 1000 * (m / 2 - l) ≤ 735 * (m / 2 - k) ∧ m < n ∧
            n ≤ 3 * (m / 2)) := sorry
  intro n k m l hk hn hl hm hkl heq
  rcases h_rest n k m l hk hn hl hm hkl heq with hD | ⟨h1, h2, h3, h4, h5⟩
  · exact hD
  · exfalso
    have hy := h_yamada (m / 2) (m % 2) (m / 2 - l) (m / 2 - k) (n - 2 * (m / 2)) h1 (by omega)
      (by omega) (by omega) h3 (by omega) (by omega)
    have a1 : 2 * (m / 2) + m % 2 = m := by omega
    have a2 : m / 2 - (m / 2 - l) = l := by omega
    have a3 : 2 * (m / 2) + (n - 2 * (m / 2)) = n := by omega
    have a4 : m / 2 - (m / 2 - k) = k := by omega
    rw [a1, a2, a3, a4] at hy
    exact hy heq.symm
