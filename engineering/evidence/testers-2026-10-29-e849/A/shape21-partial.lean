      + ((y : ℤ) + 2) * ((y : ℤ) + 1) * g3
  have hpoly := Nat.eq_of_mul_eq_mul_left hc key
  have hz : ((y : ℤ) + k + 2) * ((y : ℤ) + k + 1) * ((k : ℤ) + 1) = ((y : ℤ) + 2) * ((y : ℤ) + 1) * y := by
