import Mathlib
import Nodes.«spec-5e2e0890--h2».Context

/-! Hole `h3` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem spec_5e2e0890__h2 : ∀ (A B : Set ℕ),
  (0 : ℕ) ∉ A →
    (0 : ℕ) ∉ B →
      ∑' (n : (↑A : Type)), (1 : ℝ) / ((2 : ℝ) ^ (↑n : ℕ) - (1 : ℝ)) =
          ∑' (n : (↑B : Type)), (1 : ℝ) / ((2 : ℝ) ^ (↑n : ℕ) - (1 : ℝ)) →
        ∀ (g : ℕ → ℝ),
          Summable g →
            (∀ (m : ℕ), (0 : ℝ) ≤ g m) →
              ∀ (S T : Set ℕ),
                ∀ n ∈ S,
                  n ∉ T →
                    (∀ m < n, m ∈ S ↔ m ∈ T) →
                      ∑' (k : ℕ), g (n + (1 : ℕ) + k) < g n →
                        ∑' (m : (↑T : Type)), g (↑m : ℕ) < ∑' (m : (↑S : Type)), g (↑m : ℕ) := by
  intro A B hA hB h
  intro g hg hg0 S T n hnS hnT hagree hgap
  have hsum : ∀ U : Set ℕ, Summable (fun m : U => g m) := fun U => hg.subtype U
  have hL : ({m | m < n} ∩ S : Set ℕ) = {m | m < n} ∩ T := by
    ext m
    simp only [Set.mem_inter_iff, Set.mem_setOf_eq]
    exact and_congr_right (hagree m)
  have hT_sub : T ⊆ ({m | m < n} ∩ T) ∪ {m | n < m} := by
    intro m hm
    rcases lt_trichotomy m n with hlt | rfl | hgt
    · exact Or.inl ⟨hlt, hm⟩
    · exact absurd hm hnT
    · exact Or.inr hgt
  have hS_sup : ({m | m < n} ∩ S) ∪ {n} ⊆ S := by
    intro m hm
    rcases hm with ⟨_, hm⟩ | hm
    · exact hm
    · rw [Set.mem_singleton_iff] at hm
      exact hm ▸ hnS
  have htail : ∑' m : {m | n < m}, g m = ∑' k : ℕ, g (n + 1 + k) := by
    let e : ℕ ≃ {m : ℕ | n < m} :=
      { toFun := fun k => ⟨n + 1 + k, by simp only [Set.mem_setOf_eq]; omega⟩
        invFun := fun m => m.1 - (n + 1)
        left_inv := fun k => by simp only; omega
        right_inv := fun m => by
          apply Subtype.ext
          have := m.2
          simp only [Set.mem_setOf_eq] at this
          simp only
          omega }
    rw [← Equiv.tsum_eq e]
    rfl
  have hmono : ∀ U V : Set ℕ, U ⊆ V → ∑' m : U, g m ≤ ∑' m : V, g m := by
    intro U V hUV
    exact Summable.tsum_le_tsum_of_inj (Set.inclusion hUV) (Set.inclusion_injective hUV)
      (fun c _ => hg0 c) (fun i => le_rfl) (hsum U) (hsum V)
  have hdisj1 : Disjoint ({m | m < n} ∩ T : Set ℕ) {m | n < m} := by
    rw [Set.disjoint_left]
    rintro m ⟨hlt, _⟩ hgt
    simp only [Set.mem_setOf_eq] at hlt hgt
    omega
  have hdisj2 : Disjoint ({m | m < n} ∩ S : Set ℕ) {n} := by
    rw [Set.disjoint_left]
    rintro m ⟨hlt, _⟩ hm
    rw [Set.mem_singleton_iff] at hm
    simp only [Set.mem_setOf_eq] at hlt
    omega
  calc ∑' m : T, g m ≤ ∑' m : ↥(({m | m < n} ∩ T) ∪ {m | n < m}), g m := hmono _ _ hT_sub
    _ = ∑' m : ↥({m | m < n} ∩ T), g m + ∑' m : {m | n < m}, g m :=
        Summable.tsum_union_disjoint hdisj1 (hsum _) (hsum _)
    _ = ∑' m : ↥({m | m < n} ∩ T), g m + ∑' k : ℕ, g (n + 1 + k) := by rw [htail]
    _ < ∑' m : ↥({m | m < n} ∩ T), g m + g n := by linarith
    _ = ∑' m : ↥({m | m < n} ∩ S), g m + ∑' m : ({n} : Set ℕ), g m := by
        rw [hL, tsum_singleton]
    _ = ∑' m : ↥(({m | m < n} ∩ S) ∪ {n}), g m :=
        (Summable.tsum_union_disjoint hdisj2 (hsum _) (hsum _)).symm
    _ ≤ ∑' m : S, g m := hmono _ _ hS_sup
