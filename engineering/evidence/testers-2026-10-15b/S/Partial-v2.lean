  -- Apply the term2_comparison lemma.
  have h_term2 : (δ * W ^ 2 / (ell ^ r * D_r)) ^ (1 / (r - 1 : ℝ)) ≤ 4 * (δ * W ^ 2 / (D_r * lam ^ r)) ^ (1 / (r - 1 : ℝ)) := by
