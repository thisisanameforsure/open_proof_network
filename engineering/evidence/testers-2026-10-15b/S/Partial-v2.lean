-/
private lemma algebraic_comparison
    (r : ℕ) (hr : 2 ≤ r)
    (D_r D_r1 W δ : ℝ) (hDr : 0 < D_r) (hDr1 : 0 < D_r1)
    (hW : 1 ≤ W) (hδ : 0 < δ)
    (ell : ℕ) (lam : ℝ) (hell : 0 < ell)
    (hell_le : (ell : ℝ) ≤ lam) (hlam_lt : lam < 2 * (ell : ℝ)) :
    C₀_const *
      (((ell : ℝ) ^ (r : ℕ) * D_r * W ^ 2) ^ ((2 * (r : ℝ) - 1)⁻¹) +
