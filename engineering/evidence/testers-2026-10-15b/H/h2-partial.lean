import Mathlib
import Nodes.«erdos-1094--h3--h2».Context

open scoped Nat

/-! Hole `h_els` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_1094__h3__h2 : ∃ (C : ℕ) (K₁ : ℕ),
  ∀ (n k : ℕ), K₁ < k → (2 : ℕ) * k ≤ n → (n.choose k).minFac > k → k * k ≤ C * (n * Nat.log (2 : ℕ) k) := by
  -- Partial proof along Erdős–Lacampagne–Selfridge, "Estimates of the least prime factor of a
  -- binomial coefficient", Math. Comp. 61 (1993) 215–224, Theorem 1 (p. 216) and its proof
  -- (pp. 216–218). ELS write N = n + k for the top; our n is their N. Three ranges:
  -- h_ees: N ≤ k^{1+c}. ELS p. 216: "It was shown in [1] that there is an absolute constant c > 0
  -- for which g(k) > k^{1+c}" — Ecklund, Erdős, Selfridge, "A new function associated with the
  -- prime factors of (n k)", Math. Comp. 28 (1974). Cited by ELS, not proved there.
  have h_ees : ∃ c : ℝ, 0 < c ∧ ∃ K₂ : ℕ, ∀ n k : ℕ, K₂ < k → 2 * k ≤ n →
      (n.choose k).minFac > k → (k : ℝ) ^ (1 + c) < (n : ℝ) := by
    sorry
  -- h_caseB: k^{1+c} < N < k^{7/4} (ELS p. 217, "Now only the case k^{1+c} < n + k < k^{7/4}
  -- remains"): some prime p in (k/2, k/2 + k^{7/8}) has two multiples in (N − k, N], hence
  -- divides C(N, k); proof counts the 'unusable' primes against Ingham's count of primes in
  -- (k/2, k/2 + k^{7/8}). The argument needs only N > 2k + 6k^{7/8}, so it holds for every c > 0.
  have h_caseB : ∀ c : ℝ, 0 < c → ∃ K₃ : ℕ, ∀ n k : ℕ, K₃ < k → (k : ℝ) ^ (1 + c) < (n : ℝ) →
      (n : ℝ) < (k : ℝ) ^ ((7 : ℝ) / 4) →
      ∃ p : ℕ, p.Prime ∧ k < 2 * p ∧ p < k ∧ p ∣ n.choose k := by
    sorry
  -- h_caseA: k^{7/4} ≤ N < c₁k²/ln k (ELS pp. 216–217, inequalities (1)–(4)): Ingham gives two
  -- primes k/2 < p₁ < p₂ < p₁ + c₂ ln k < k/2 + k^{3/4}; one of them has two multiples in
  -- (N − k, N], hence divides C(N, k). Here c₁k²/ln k is written k² > C·N·log₂ k (C = ⌈ln 2 / c₁⌉).
  have h_caseA : ∃ C K₄ : ℕ, ∀ n k : ℕ, K₄ < k → (k : ℝ) ^ ((7 : ℝ) / 4) ≤ (n : ℝ) →
      C * (n * Nat.log 2 k) < k * k →
      ∃ p : ℕ, p.Prime ∧ k < 2 * p ∧ p < k ∧ p ∣ n.choose k := by
    sorry
  -- Assembly: the three ranges cover every good N; a prime p < k dividing C(N, k) contradicts
  -- least prime factor > k.
  obtain ⟨c, hc, K₂, hE⟩ := h_ees
  obtain ⟨K₃, hB⟩ := h_caseB c hc
  obtain ⟨C, K₄, hA⟩ := h_caseA
  refine ⟨C, max K₂ (max K₃ K₄), fun n k hk h2k hmin => ?_⟩
  have hk2 : K₂ < k := lt_of_le_of_lt (le_max_left _ _) hk
  have hk3 : K₃ < k := lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) hk
  have hk4 : K₄ < k := lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_right _ _)) hk
  by_contra hlt
  push_neg at hlt
  have he := hE n k hk2 h2k hmin
  have key : ∃ p : ℕ, p.Prime ∧ k < 2 * p ∧ p < k ∧ p ∣ n.choose k := by
    rcases lt_or_ge (n : ℝ) ((k : ℝ) ^ ((7 : ℝ) / 4)) with h | h
    · exact hB n k hk3 he h
    · exact hA n k hk4 h hlt
  obtain ⟨p, hp, _, hpk, hd⟩ := key
  have hle := Nat.minFac_le_of_dvd hp.two_le hd
  omega
