import Mathlib
import Nodes.«erdos-1094--h3--h2».Context

open scoped Nat

/-! Hole `h_els` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_1094__h3__h2 : ∃ (C : ℕ) (K₁ : ℕ),
  ∀ (n k : ℕ), K₁ < k → (2 : ℕ) * k ≤ n → (n.choose k).minFac > k → k * k ≤ C * (n * Nat.log (2 : ℕ) k) := by
  -- annex: ANNEXHASH
  -- Erdős, Lacampagne, Selfridge, "Estimates of the least prime factor of a binomial
  -- coefficient", Math. Comp. 61 (1993) 215–224, Theorem 1 (p. 216): g(k) > c₁k²/ln k, the
  -- input Granville–Ramaré cite in §5e. ELS's proof (pp. 216–217) splits N = n (our n, their
  -- N) into three ranges. Contrapositive form: if k² > C·n·log₂k then C(n,k) has a prime
  -- factor ≤ k.
  -- h_ees: the range n ≤ k^(1+c), cited by ELS p. 216 from [1] = Ecklund, Erdős, Selfridge,
  -- Math. Comp. 28 (1974) 647–649: g(k) > k^(1+c) for an absolute c > 0.
  have h_ees : ∃ c : ℝ, 0 < c ∧ ∃ K₀ : ℕ, ∀ n k : ℕ, K₀ < k → 2 * k ≤ n →
      (n : ℝ) ≤ (k : ℝ) ^ (1 + c) → (n.choose k).minFac ≤ k := by
    sorry
  -- h_mid: ELS p. 217, "Now only the case k^(1+c) < n + k < k^(7/4) remains": a prime p in
  -- (k/2, k/2 + k^(7/8)) whose two consecutive multiples straddle (N − k, N], i.e. a carry in
  -- the last base-p digit (n % p < k % p); counting unusable primes against Ingham's
  -- k^(7/8)/ln k primes in that interval. Stated with the weaker range k/2 < p ≤ k.
  have h_mid : ∀ c : ℝ, 0 < c → ∃ K₅ : ℕ, ∀ n k : ℕ, K₅ < k → (k : ℝ) ^ (1 + c) < n →
      (n : ℝ) < (k : ℝ) ^ ((7 : ℝ) / 4) →
      ∃ p : ℕ, p.Prime ∧ k < 2 * p ∧ p ≤ k ∧ n % p < k % p := by
    sorry
  -- h_top: ELS pp. 216–217, the range k^(7/4) < N < c₁k²/ln k: by Ingham [3] two primes
  -- p₁ < p₂ < p₁ + c₂ ln k in (k/2, k/2 + k^(3/4)), and one of them has a last-digit carry
  -- ((1)–(4) there). c₁ < (1 − δ)/c₂ becomes the existential C (ln k vs log₂ k absorbed).
  have h_top : ∃ C K₆ : ℕ, ∀ n k : ℕ, K₆ < k → (k : ℝ) ^ ((7 : ℝ) / 4) ≤ n →
      C * (n * Nat.log 2 k) < k * k →
      ∃ p : ℕ, p.Prime ∧ k < 2 * p ∧ p ≤ k ∧ n % p < k % p := by
    sorry
  -- Assembly: the three ranges cover every n; a last-digit carry puts p ≤ k in C(n,k)
  -- (Lucas' theorem; ELS Lemma 1, p. 218).
  obtain ⟨c, hc, K₀, hE⟩ := h_ees
  obtain ⟨K₅, hM⟩ := h_mid c hc
  obtain ⟨C, K₆, hT⟩ := h_top
  refine ⟨C, max K₀ (max K₅ K₆), fun n k hk h2k hmin => ?_⟩
  have h0 : K₀ < k := lt_of_le_of_lt (le_max_left _ _) hk
  have h5 : K₅ < k := lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) hk
  have h6 : K₆ < k := lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_right _ _)) hk
  by_contra hlt'
  have hlt : C * (n * Nat.log 2 k) < k * k := Nat.lt_of_not_le hlt'
  have carry : ∀ p : ℕ, p.Prime → p ≤ k → n % p < k % p → False := by
    intro p hp hpk hmod
    have hfact : Fact p.Prime := ⟨hp⟩
    have hzero : (n % p).choose (k % p) = 0 := Nat.choose_eq_zero_of_lt hmod
    have hmodeq := Choose.choose_modEq_choose_mod_mul_choose_div_nat (n := n) (k := k) (p := p)
    rw [hzero, zero_mul] at hmodeq
    have hdvd : p ∣ n.choose k := (Nat.modEq_zero_iff_dvd).1 hmodeq
    have hle : (n.choose k).minFac ≤ p := Nat.minFac_le_of_dvd hp.two_le hdvd
    omega
  rcases le_or_gt (n : ℝ) ((k : ℝ) ^ (1 + c)) with h1 | h1
  · have := hE n k h0 h2k h1
    omega
  · rcases lt_or_ge (n : ℝ) ((k : ℝ) ^ ((7 : ℝ) / 4)) with h2 | h2
    · obtain ⟨p, hp, -, hpk, hmod⟩ := hM n k h5 h1 h2
      exact carry p hp hpk hmod
    · obtain ⟨p, hp, -, hpk, hmod⟩ := hT n k h6 h2 hlt
      exact carry p hp hpk hmod
