import Mathlib
import Nodes.«erdos-1094--h3».Context

open scoped Nat

/-! Hole `h_small_n` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_1094__h3 : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → (2 : ℕ) * k ≤ n → n < k * k → (n.choose k).minFac > k → k ≤ K := by
  -- annex: 1df9e2016f247088c7a0bdc58643dc56fc5169dfeb1a094e1c9ce30cb42abcc2
  -- Skeleton of Granville–Ramaré, Mathematika 43 (1996) 73–107, Theorem 8 (preprint p. 5),
  -- proof in §5e (preprint pp. 24–25). Their n is our n − k (they write C(n+k, k)).
  -- h_els: the input GR cite and do not prove (§5e, p. 24: "That n ≫ k²/log k has been proved
  -- in [ELS], so we may assume this"): Erdős–Lacampagne–Selfridge, Math. Comp. 61 (1993)
  -- 215–224. Stated with Nat.log 2 k in place of log k (same up to the constant C), and for
  -- our n ≥ their n.
  have h_els : ∃ C K₁ : ℕ, ∀ n k : ℕ, K₁ < k → 2 * k ≤ n → (n.choose k).minFac > k →
      k * k ≤ C * (n * Nat.log 2 k) := by
    sorry
  -- h_gr: GR §5e, pp. 24–25, the argument after "Let p be any prime in the interval
  -- k/2 < p < (k/2)(1 + ε) where ε = 1/10": for n in the range ELS leaves (n ≫ k²/log k,
  -- here capped at n < k²) the equidistribution bound (5.1) (p. 18, from Sander [Sa2] via
  -- Lemma 5.1) forbids every such p from having a small residue, so some prime p in
  -- (k/2, 11k/20) has a carry in the last base-p digit of k + (n − k), i.e. n % p < k % p.
  -- Holds for every C (the threshold K₂ depends on C).
  have h_gr : ∀ C : ℕ, ∃ K₂ : ℕ, ∀ n k : ℕ, K₂ < k → k * k ≤ C * (n * Nat.log 2 k) →
      n < k * k → ∃ p : ℕ, p.Prime ∧ k < 2 * p ∧ 20 * p < 11 * k ∧ n % p < k % p := by
    sorry
  -- Assembly (GR §5e, p. 24, "p | k! but p² ∤ k!": a last-digit carry puts p in C(n,k);
  -- here by Lucas' theorem, the last-digit case of Kummer's theorem).
  obtain ⟨C, K₁, hE⟩ := h_els
  obtain ⟨K₂, hG⟩ := h_gr C
  refine ⟨max K₁ K₂, fun n k hk h2k hlt hmin => ?_⟩
  by_contra hKk'
  have hK : max K₁ K₂ < k := Nat.lt_of_not_le hKk'
  have h1 : K₁ < k := lt_of_le_of_lt (le_max_left _ _) hK
  have h2 : K₂ < k := lt_of_le_of_lt (le_max_right _ _) hK
  obtain ⟨p, hp, _, hp11, hmod⟩ := hG n k h2 (hE n k h1 h2k hmin) hlt
  have hfact : Fact p.Prime := ⟨hp⟩
  have hzero : (n % p).choose (k % p) = 0 := Nat.choose_eq_zero_of_lt hmod
  have hmodeq := Choose.choose_modEq_choose_mod_mul_choose_div_nat (n := n) (k := k) (p := p)
  rw [hzero, zero_mul] at hmodeq
  have hdvd : p ∣ n.choose k := (Nat.modEq_zero_iff_dvd).1 hmodeq
  have hle : (n.choose k).minFac ≤ p := Nat.minFac_le_of_dvd hp.two_le hdvd
  omega
