open scoped Nat

/-! Hole `h_gp` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_1094__h2__h2__h3__h1 : ∃ (K : ℕ),
  ∀ (n k : ℕ),
    (0 : ℕ) < k →
      k * k * k ≤ n →
        Real.exp (Real.log (↑k : ℝ) ^ (2 : ℕ) / ((20 : ℝ) * Real.log (Real.log (↑k : ℝ)))) < (↑n : ℝ) + (1 : ℝ) →
          k * (n / k) ∣ k.factorial → (n.choose k).minFac > n / k → Nat.Prime (n / n.gcd k) → k ≤ K := by
  -- Proved here: if k ∣ n then gcd(n,k) = k, so p := n/k is prime with p ∣ k! (as p ∣ k*(n/k)),
  -- hence p ≤ k; but p = n/k ≥ k*k > k for k ≥ 2. So only k ∤ n remains open.
  have h_ndvd : ∃ (K : ℕ),
      ∀ (n k : ℕ),
        (0 : ℕ) < k →
          k * k * k ≤ n →
            Real.exp (Real.log (↑k : ℝ) ^ (2 : ℕ) / ((20 : ℝ) * Real.log (Real.log (↑k : ℝ)))) < (↑n : ℝ) + (1 : ℝ) →
              k * (n / k) ∣ k.factorial → (n.choose k).minFac > n / k → Nat.Prime (n / n.gcd k) →
                ¬ k ∣ n → k ≤ K := by
    sorry
  obtain ⟨K, hK⟩ := h_ndvd
  refine ⟨max K 1, fun n k hk hn he hd hm hp => ?_⟩
  by_cases hkn : k ∣ n
  · rcases Nat.lt_or_ge k 2 with h1 | h2
    · exact le_trans (by omega) (le_max_right K 1)
    · exfalso
      have hg : n.gcd k = k := Nat.gcd_eq_right hkn
      rw [hg] at hp
      have hpk : n / k ∣ k.factorial := (Dvd.intro_left k rfl).trans hd
      have hle : n / k ≤ k := (Nat.Prime.dvd_factorial hp).1 hpk
      have hkk : k * k ≤ n / k := (Nat.le_div_iff_mul_le hk).2 hn
      nlinarith
  · exact le_trans (hK n k hk hn he hd hm hp hkn) (le_max_left K 1)
