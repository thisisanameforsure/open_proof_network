theorem erdos_1094__h2__h1__h1__h1 : ∃ (K : ℕ),
  ∀ (n k : ℕ),
    (0 : ℕ) < k → (2 : ℕ) * k ≤ n → n < k * k * k → (n.choose k).minFac > k → (n / n.gcd k).minFac > k → k ≤ K := by
  -- Split the range 2k ≤ n < k³ at n = k²: the lower band (n < k², Sylvester–Schur/Ecklund
  -- regime) and the upper band (k² ≤ n < k³). Each hole carries a stronger hypothesis.
  have h_low : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → (2 : ℕ) * k ≤ n → n < k * k →
      (n.choose k).minFac > k → (n / n.gcd k).minFac > k → k ≤ K := by
    sorry
  have h_high : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → k * k ≤ n → n < k * k * k →
      (n.choose k).minFac > k → (n / n.gcd k).minFac > k → k ≤ K := by
    sorry
  obtain ⟨K1, hK1⟩ := h_low
  obtain ⟨K2, hK2⟩ := h_high
  refine ⟨max K1 K2, fun n k hk hn hn3 hc hg => ?_⟩
  rcases lt_or_ge n (k * k) with h | h
  · exact le_max_of_le_left (hK1 n k hk hn h hc hg)
  · exact le_max_of_le_right (hK2 n k hk h hn3 hc hg)
