import Mathlib
import Nodes.«erdos-68--h3».Context

/-! Hole `h3` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_68__h3 : ∀ (M : ℕ),
  ∃ (N : ℕ),
    M ≤ N ∧
      Int.fract (∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ))) <
        (1 : ℝ) - (2 : ℝ) / (↑N : ℝ) := by
  -- approach: strengthen to a statement about one real number: N!·S stays a fixed distance from the integers for infinitely many N; with the tail split, the finite sum's fractional part is then below 1 - 2/N
  -- licence: CC-BY-4.0
  -- label: N!·S splits as the finite sum plus a tail in (0, 2/N]
  -- claim: $\forall N\ge 2\ \exists c,\ 0<c\le \tfrac{2}{N}\ \text{and}\ N!\sum_{n\ge 2}\frac{1}{n!-1}=\sum_{n=2}^{N}\frac{N!}{n!-1}+c$
  -- The same statement as the tail split under the root's first decomposition.
  have ht : ∀ (N : ℕ), (2 : ℕ) ≤ N → ∃ (c : ℝ), (0 : ℝ) < c ∧ c ≤ (2 : ℝ) / (↑N : ℝ) ∧
      (↑N.factorial : ℝ) * ∑' (n : ℕ), (1 : ℝ) / ((↑(n + (2 : ℕ)).factorial : ℝ) - (1 : ℝ)) =
        ∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ)) + c := sorry
  -- label: N!·S keeps away from the integers infinitely often
  -- claim: $\exists \delta>0\ \forall M\ \exists N\ge M:\ \delta\le\operatorname{frac}\Big(N!\sum_{n\ge 2}\frac{1}{n!-1}\Big)\le 1-\delta$
  -- In words: the distance from N!·S to the nearest integer does not tend to 0.
  have hcore : ∃ δ : ℝ, 0 < δ ∧ ∀ M : ℕ, ∃ N : ℕ, M ≤ N ∧
      δ ≤ Int.fract ((N.factorial : ℝ) * ∑' n : ℕ, (1 : ℝ) / (((n + 2).factorial : ℝ) - 1)) ∧
      Int.fract ((N.factorial : ℝ) * ∑' n : ℕ, (1 : ℝ) / (((n + 2).factorial : ℝ) - 1)) ≤ 1 - δ := sorry
  intro M
  obtain ⟨δ, hδ, hinf⟩ := hcore
  obtain ⟨K, hK⟩ := exists_nat_gt (2 / δ)
  obtain ⟨N, hN, hlo, hhi⟩ := hinf (max M (max K 2))
  refine ⟨N, le_trans (le_max_left _ _) hN, ?_⟩
  have hN2 : 2 ≤ N := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hN
  have hKN : K ≤ N := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hN
  obtain ⟨c, hc0, hc2, hS⟩ := ht N hN2
  have hNpos : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hKr : (K : ℝ) ≤ N := by exact_mod_cast hKN
  have hδN : 2 / (N : ℝ) < δ := by
    have h1 : 2 / δ < N := lt_of_lt_of_le hK hKr
    rw [div_lt_iff₀ hδ] at h1
    rw [div_lt_iff₀ hNpos]
    linarith
  set x := (N.factorial : ℝ) * ∑' n : ℕ, (1 : ℝ) / (((n + 2).factorial : ℝ) - 1) with hx
  set F := ∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ)) with hF
  have hxF : x = F + c := by rw [hx]; exact hS
  have key : Int.fract F = Int.fract x - c := by
    rw [Int.fract_eq_iff]
    refine ⟨by linarith, by linarith [Int.fract_lt_one x], ⌊x⌋, ?_⟩
    rw [Int.fract]
    linarith
  rw [key]
  linarith
