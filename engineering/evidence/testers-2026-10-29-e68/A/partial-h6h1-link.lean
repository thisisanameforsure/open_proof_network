import Mathlib
import Nodes.«erdos-68--h6--h1».Context

/-! Hole `h1` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_68__h6__h1 : ∀ (M : ℕ),
  ∃ (N : ℕ),
    M ≤ N ∧
      Int.fract (∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ))) ≤
        (1 : ℝ) - (1 : ℝ) / (↑N : ℝ) := by
  -- approach: route 1's open core erdos-68--h3 is the same inequality with the smaller bound 1 - 2/N, so it gives this one directly
  -- licence: CC-BY-4.0
  -- label: the finite sum's fractional part is below 1 - 2/N infinitely often
  -- claim: $\forall M\ \exists N\ge M:\ \operatorname{frac}\Big(\sum_{n=2}^{N}\frac{N!}{n!-1}\Big)<1-\frac{2}{N}$
  -- The same statement as the open hole of the root's first decomposition.
  have hl : ∀ (M : ℕ), ∃ (N : ℕ), M ≤ N ∧
      Int.fract (∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ))) <
        (1 : ℝ) - (2 : ℝ) / (↑N : ℝ) := sorry
  intro M
  obtain ⟨N, hMN, hfr⟩ := hl M
  refine ⟨N, hMN, ?_⟩
  have h0 : (0 : ℝ) ≤ (1 : ℝ) / (↑N : ℝ) := by positivity
  have h2 : (2 : ℝ) / (↑N : ℝ) = 2 * ((1 : ℝ) / (↑N : ℝ)) := by ring
  rw [h2] at hfr
  linarith
