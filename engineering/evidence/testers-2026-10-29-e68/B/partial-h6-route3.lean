/-! Hole `h3` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_68__h6 : ∀ (M : ℕ),
  ∃ (N : ℕ),
    M ≤ N ∧
      (Int.fract (∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ))) ≤
          (1 : ℝ) - (1 : ℝ) / (↑N : ℝ) ∨
        (1 : ℝ) - (1 : ℝ) / ((↑N : ℝ) + (1 : ℝ)) ≤
          Int.fract (∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ)))) := by
  -- approach: keep only the first disjunct: the finite part's fractional part at most 1 − 1/N infinitely often; that implies this node, and it is implied by --h3 (1 − 2/N < 1 − 1/N), so the open core sits strictly between the root and --h3
  -- licence: CC-BY-4.0
  -- label: fract(F_N) ≤ 1 − 1/N infinitely often
  -- claim: $\forall M\in\mathbb{N}\ \exists N\ge M:\ \Big\{\sum_{n=2}^{N}\frac{N!}{n!-1}\Big\}\le 1-\frac{1}{N}$
  -- Here $\{\cdot\}$ is the fractional part and the sum is over $2\le n\le N$.
  have h1 : ∀ M : ℕ, ∃ N : ℕ, M ≤ N ∧
      Int.fract (∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ))) ≤ (1 : ℝ) - (1 : ℝ) / (↑N : ℝ) := sorry
  intro M
  obtain ⟨N, hMN, h⟩ := h1 M
  exact ⟨N, hMN, Or.inl h⟩
