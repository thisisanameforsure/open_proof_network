/-! Hole `h1` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_68__h6__h1 : ∀ (M : ℕ),
  ∃ (N : ℕ),
    M ≤ N ∧
      Int.fract (∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ))) ≤
        (1 : ℝ) - (1 : ℝ) / (↑N : ℝ) := by
  -- approach: pass from the finite part to S itself: if the next factorial digit of S is infinitely often neither 0, 1 nor its largest value, the tail bound places the finite part's fractional part at most 1 − 1/N
  -- licence: CC-BY-4.0
  -- label: N!·S = F_N + c with 1/(N+1) < c < 1/N
  -- claim: $\forall N\ge 4\ \exists c:\ \tfrac{1}{N+1}<c<\tfrac1N\ \text{and}\ N!\,S=\sum_{n=2}^{N}\frac{N!}{n!-1}+c$
  have ht : ∀ (N : ℕ), (4 : ℕ) ≤ N → ∃ (c : ℝ), (1 : ℝ) / ((↑N : ℝ) + (1 : ℝ)) < c ∧ c < (1 : ℝ) / (↑N : ℝ) ∧
      (↑N.factorial : ℝ) * ∑' (n : ℕ), (1 : ℝ) / ((↑(n + (2 : ℕ)).factorial : ℝ) - (1 : ℝ)) =
        ∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ)) + c := sorry
  -- label: S's next factorial digit often in [2, N−1]
  -- claim: $\forall M\ \exists N\ge M:\ \tfrac{2}{N+1}\le\{N!\,S\}<1-\tfrac{1}{N+1},\quad S=\sum_{n\ge2}\frac{1}{n!-1}$
  -- Equivalently, the digit $a_{N+1}=\lfloor (N+1)\{N!\,S\}\rfloor$ of $S$ in base factorial satisfies $2\le a_{N+1}\le N-1$.
  have hd : ∀ (M : ℕ), ∃ (N : ℕ), M ≤ N ∧
      (2 : ℝ) / ((↑N : ℝ) + (1 : ℝ)) ≤
        Int.fract ((↑N.factorial : ℝ) * ∑' (n : ℕ), (1 : ℝ) / ((↑(n + (2 : ℕ)).factorial : ℝ) - (1 : ℝ))) ∧
      Int.fract ((↑N.factorial : ℝ) * ∑' (n : ℕ), (1 : ℝ) / ((↑(n + (2 : ℕ)).factorial : ℝ) - (1 : ℝ))) <
        (1 : ℝ) - (1 : ℝ) / ((↑N : ℝ) + (1 : ℝ)) := sorry
  intro M
  obtain ⟨N, hMN, hlo, hhi⟩ := hd (max M 4)
  have hN4 : 4 ≤ N := le_trans (le_max_right _ _) hMN
  obtain ⟨c, hc0, hc1, hS⟩ := ht N hN4
  refine ⟨N, le_trans (le_max_left _ _) hMN, ?_⟩
  set T := (↑N.factorial : ℝ) * ∑' (n : ℕ), (1 : ℝ) / ((↑(n + (2 : ℕ)).factorial : ℝ) - (1 : ℝ)) with hT
  set F := ∑ n ∈ Finset.Icc (2 : ℕ) N, (↑N.factorial : ℝ) / ((↑n.factorial : ℝ) - (1 : ℝ)) with hF
  have hNpos : (0 : ℝ) < N := by exact_mod_cast (by omega : 0 < N)
  have hN1 : (0 : ℝ) < (N : ℝ) + 1 := by linarith
  have h2N : (1 : ℝ) / N ≤ 2 / ((N : ℝ) + 1) := by
    have h4 : (4 : ℝ) ≤ N := by exact_mod_cast hN4
    rw [div_le_div_iff₀ hNpos hN1]; linarith
  have hsmall : (1 : ℝ) / N - 1 / ((N : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) := by
    have : (1 : ℝ) / N ≤ 2 / ((N : ℝ) + 1) := h2N
    have e : (2 : ℝ) / ((N : ℝ) + 1) = 1 / ((N : ℝ) + 1) + 1 / ((N : ℝ) + 1) := by ring
    linarith
  have hfr : Int.fract F = Int.fract T - c := by
    rw [Int.fract_eq_iff]
    refine ⟨by linarith, by linarith [Int.fract_nonneg T], ⌊T⌋, ?_⟩
    have : T = F + c := hS
    have h := Int.floor_add_fract T
    linarith
  rw [hfr]
  have : (1 : ℝ) - 1 / ((N : ℝ) + 1) - c ≤ 1 - 1 / N := by linarith
  linarith
