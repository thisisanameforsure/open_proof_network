        have hm1 : (1 : ℤ) ≤ m := by exact_mod_cast (show 1 ≤ m by omega)
        linarith [hm.2]
      · rw [← @Int.cast_lt ℝ]; push_cast; linarith [hmp, h_case]
      · exact dvd_mul_left _ _
  · left
    rintro ⟨C, hC, k₀, hk⟩
    exact hB ⟨C, hC, k₀, fun k hk' => by rw [hpc]; exact hk k hk'⟩
