      rw [hex, hey, h]
    have hgcd : (L / K x * J x).gcd (L / K y * J y) * A.max' hne = L * x.gcd y := by
      have h := Nat.gcd_mul_left L x y
      rw [hex, hey, Nat.gcd_mul_right] at h
      exact h
