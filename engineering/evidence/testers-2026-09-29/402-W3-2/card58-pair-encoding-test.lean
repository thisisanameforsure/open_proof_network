        · exact h
      refine ⟨k, j, hkN, hjk, hj1, ?_⟩
      have hLk := hL k hkN (by omega)
      rw [hj, hk]
      calc L * (g * j) = (L / k * k) * (g * j) := by rw [hLk]
        _ = L / k * j * (g * k) := by ring
    have hcard : (A.erase (A.max' hne)).card = n - 1 := by
      rw [Finset.card_erase_of_mem hM, hn]
    choose! K J hK hJ hJ0 hKJ using forms
    have hmaps : ∀ x ∈ A.erase (A.max' hne),
        (tbl.getD (K x) []).getD (J x) 0 ∈ Finset.range (n - 2) := by
      intro x hx
      rw [Finset.mem_range]
      exact (H1 (K x) (hK x hx) (J x) (hJ x hx) (hJ0 x hx)).1
    obtain ⟨x, hx, y, hy, hxy, hc⟩ :=
      Finset.exists_ne_map_eq_of_card_lt_of_maps_to (by rw [hcard, Finset.card_range]; omega) hmaps
    have hex := hKJ x hx
    have hey := hKJ y hy
    have h1 := (H1 (K x) (hK x hx) (J x) (hJ x hx) (hJ0 x hx)).2
    have h2 := (H1 (K y) (hK y hy) (J y) (hJ y hy) (hJ0 y hy)).2
