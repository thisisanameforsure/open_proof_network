          _ = n * (L / K x * J x).gcd (L / K y * J y) * A.max' hne := by ring
          _ ≤ L / K x * J x * A.max' hne := h3
          _ = L * x := hex.symm
      exact Nat.le_of_mul_le_mul_left h5 hLpos
    · refine ⟨y, hyA, x, hxA, key y x ?_⟩
      rw [hn, Nat.gcd_comm]
      have h3 := Nat.mul_le_mul_right (A.max' hne) h
      have h5 : L * (x.gcd y * n) ≤ L * y := by
        calc L * (x.gcd y * n) = n * (L * x.gcd y) := by ring
          _ = n * ((L / K x * J x).gcd (L / K y * J y) * A.max' hne) := by rw [hgcd]
          _ = n * (L / K x * J x).gcd (L / K y * J y) * A.max' hne := by ring
          _ ≤ L / K y * J y * A.max' hne := h3
          _ = L * y := hey.symm
      exact Nat.le_of_mul_le_mul_left h5 hLpos
