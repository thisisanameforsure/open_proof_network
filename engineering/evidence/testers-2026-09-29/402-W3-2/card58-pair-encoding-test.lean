theorem card_test : ∀ (B : Finset ℕ), 0 ∉ B → B.card = 58 → ∃ a ∈ B, ∃ b ∈ B, a.gcd b ≤ (a / B.card : ℚ) := by
  have general : ∀ (n L : ℕ) (cls : List (List ℕ)) (C : List (List (ℕ × ℕ))) (tbl : List (List ℕ)),
      cls = C.map (fun c => c.map (fun p => L / p.1 * p.2)) → 2 ≤ n → 0 < L →
      (∀ k < n, 0 < k → L / k * k = L) →
      (∀ k < n, ∀ j < k, 0 < j →
        (tbl.getD k []).getD j 0 < n - 2 ∧ L / k * j ∈ cls.getD ((tbl.getD k []).getD j 0) []) →
      (∀ i < n - 2, ∀ v ∈ cls.getD i [], ∀ w ∈ cls.getD i [], v ≠ w →
        n * v.gcd w ≤ v ∨ n * v.gcd w ≤ w) →
      ∀ A : Finset ℕ, 0 ∉ A → A.card = n → ∃ a ∈ A, ∃ b ∈ A, a.gcd b ≤ (a / A.card : ℚ) := by
