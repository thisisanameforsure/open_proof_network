    -- the double family
    set f : ℕ → ℕ → ℝ := fun j k => x ^ (k + 1) * ((1 : ℝ) / 2 ^ (j + 1)) ^ (k + 1) with hfdef
    have hf0 : ∀ j k, 0 ≤ f j k := fun j k => by positivity
    -- rows (fixed j): a geometric series
    have hrow : ∀ j : ℕ, HasSum (f j) (3 / ((2 : ℝ) ^ (j + n + 1) - 3)) := by
