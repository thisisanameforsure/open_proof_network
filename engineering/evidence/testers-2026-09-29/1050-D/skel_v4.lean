      have h := ((hasSum_geometric_of_lt_one hq0 hq1).mul_left (1 / 2 ^ (k + 1))).mul_left (x ^ (k + 1))
      have hpos : (0 : ℝ) < 2 ^ (k + 1) - 1 := by
