    have hp : (0 : ℝ) < 2 ^ (2 * n + t) := by positivity
    rw [div_le_iff₀ (mul_pos hA (by linarith)), one_div_pow]
    have hkey : (1 : ℝ) ≤ 1 / 2 ^ (2 * n + t) * ((2 : ℝ) ^ (2 * n + 1 + t - 0) - 1) := by
