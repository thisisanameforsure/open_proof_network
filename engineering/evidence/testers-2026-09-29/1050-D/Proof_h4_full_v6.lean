  -- the tail of 3T as a power series in x_n = 3/2^n
  have htail : ∀ n : ℕ, 1 ≤ n → HasSum (fun k : ℕ => ((3 : ℝ) / 2 ^ n) ^ k / ((2 : ℝ) ^ k - 1))
