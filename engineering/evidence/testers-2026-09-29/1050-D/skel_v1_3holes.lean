      exact hs.summable.tsum_pos (fun t => (hterm_pos t).le) 0 (hterm_pos 0)
    refine ⟨hRpos, ?_⟩
    have hB : (2 : ℝ) ^ (n + 1) / ((2 : ℝ) ^ n) ^ (2 * n) * (1 - 1 / 2)⁻¹ =
