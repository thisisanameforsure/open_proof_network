    have hQ : (0 : ℝ) < ((2 : ℝ) ^ n) ^ (2 * n) := by positivity
    rw [hpow]
    calc ((Qx n : ℝ) * (3 * T) - (Aq n : ℝ)) ^ 2 * (((2 : ℝ) ^ n) ^ (2 * n)) ^ 2
        = (((Qx n : ℝ) * (3 * T) - (Aq n : ℝ)) * ((2 : ℝ) ^ n) ^ (2 * n)) ^ 2 := by ring
      _ ≤ ((2 : ℝ) ^ (n + 2)) ^ 2 := by
          gcongr
          rw [le_div_iff₀ hQ] at hRle; exact hRle
      _ = (2 : ℝ) ^ (2 * n + 4) := by ring
