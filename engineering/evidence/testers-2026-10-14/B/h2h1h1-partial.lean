import Mathlib
import Nodes.«erdos-1094--h2--h1--h1».Context

open scoped Nat

/-! Hole `h_good_below_cube` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_1094__h2__h1__h1 : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → (2 : ℕ) * k ≤ n → n < k * k * k → (n.choose k).minFac > k → k ≤ K := by
  -- Proved here (assembly): n / gcd(n,k) divides C(n,k) (from k*C(n,k) = n*C(n-1,k-1) and
  -- coprimality of n/g and k/g), and n/g ≥ n/k ≥ 2, so its least prime factor is at least
  -- minFac C(n,k) > k: every prime factor of n / gcd(n,k) exceeds k.
  have h_gcd_minFac : ∀ (n k : ℕ), 0 < k → 2 * k ≤ n → (n.choose k).minFac > k →
      (n / n.gcd k).minFac > k := by
    intro n k hk hn hm
    have hn0 : 0 < n := by omega
    have hkn : k ≤ n := by omega
    set g := n.gcd k with hg
    have hg0 : 0 < g := Nat.gcd_pos_of_pos_left k hn0
    have hgn : g ∣ n := Nat.gcd_dvd_left n k
    have hgk : g ∣ k := Nat.gcd_dvd_right n k
    have hid : n * (n - 1).choose (k - 1) = n.choose k * k := by
      have := Nat.add_one_mul_choose_eq (n - 1) (k - 1)
      rwa [Nat.sub_add_cancel (by omega : 1 ≤ n), Nat.sub_add_cancel (by omega : 1 ≤ k)] at this
    have hcop : Nat.Coprime (n / g) (k / g) := Nat.coprime_div_gcd_div_gcd hg0
    have hdvd : n / g ∣ n.choose k := by
      have h1 : n / g ∣ n.choose k * (k / g) := by
        refine ⟨(n - 1).choose (k - 1), ?_⟩
        have e1 : n = n / g * g := (Nat.div_mul_cancel hgn).symm
        have e2 : k = k / g * g := (Nat.div_mul_cancel hgk).symm
        have : n / g * g * (n - 1).choose (k - 1) = n.choose k * (k / g * g) := by
          rw [← e1, ← e2]; exact hid
        have : (n / g * (n - 1).choose (k - 1)) * g = (n.choose k * (k / g)) * g := by
          linear_combination this
        exact (Nat.eq_of_mul_eq_mul_right hg0 this).symm
      exact hcop.dvd_of_dvd_mul_right h1
    have h2k : 2 ≤ n / k := (Nat.le_div_iff_mul_le hk).2 (by omega)
    have hng : n / k ≤ n / g := Nat.div_le_div_left (Nat.le_of_dvd hk hgk) hg0
    have hq2 : 2 ≤ (n / g).minFac := (Nat.minFac_prime (by omega)).two_le
    have hqC : (n.choose k).minFac ≤ (n / g).minFac :=
      Nat.minFac_le_of_dvd hq2 ((Nat.minFac_dvd _).trans hdvd)
    omega
  -- The open half: the same statement, given in addition that every prime factor of
  -- n / gcd(n,k) exceeds k.
  have h_gp : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → (2 : ℕ) * k ≤ n → n < k * k * k →
      (n.choose k).minFac > k → (n / n.gcd k).minFac > k → k ≤ K := by
    sorry
  obtain ⟨K, hK⟩ := h_gp
  exact ⟨K, fun n k hk hn hc hm => hK n k hk hn hc hm (h_gcd_minFac n k hk hn hm)⟩
