open Nat

/-! Hole `h_adjacent` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private theorem e849_adjacent_iff (m k : ℕ) (hk : k ≤ m) :
    (m + 1).choose k = m.choose (k + 1) ↔ (m + 1) * (k + 1) = (m - k) * (m + 1 - k) := by
  have h1 := Nat.choose_mul_succ_eq m k          -- m.choose k * (m + 1) = (m+1).choose k * (m + 1 - k)
  have h2 := Nat.choose_succ_right_eq m k        -- m.choose (k+1) * (k+1) = m.choose k * (m - k)
  have hpos : 0 < m.choose k := Nat.choose_pos hk
  constructor
  · intro h
    -- multiply both identities to isolate m.choose k
    have e : m.choose k * ((m + 1) * (k + 1)) = m.choose k * ((m - k) * (m + 1 - k)) := by
      calc m.choose k * ((m + 1) * (k + 1)) = (m.choose k * (m + 1)) * (k + 1) := by ring
        _ = ((m + 1).choose k * (m + 1 - k)) * (k + 1) := by rw [h1]
        _ = (m.choose (k + 1) * (k + 1)) * (m + 1 - k) := by rw [h]; ring
        _ = (m.choose k * (m - k)) * (m + 1 - k) := by rw [h2]
        _ = m.choose k * ((m - k) * (m + 1 - k)) := by ring
    exact Nat.eq_of_mul_eq_mul_left hpos e
  · intro h
    have hk1 : 0 < m + 1 - k := by omega
    have e : (m + 1).choose k * ((m + 1 - k) * (k + 1)) = m.choose (k + 1) * ((m + 1 - k) * (k + 1)) := by
      calc (m + 1).choose k * ((m + 1 - k) * (k + 1)) = ((m + 1).choose k * (m + 1 - k)) * (k + 1) := by ring
        _ = (m.choose k * (m + 1)) * (k + 1) := by rw [h1]
        _ = m.choose k * ((m + 1) * (k + 1)) := by ring
        _ = m.choose k * ((m - k) * (m + 1 - k)) := by rw [h]
        _ = (m.choose k * (m - k)) * (m + 1 - k) := by ring
        _ = (m.choose (k + 1) * (k + 1)) * (m + 1 - k) := by rw [h2]
        _ = m.choose (k + 1) * ((m + 1 - k) * (k + 1)) := by ring
    exact Nat.eq_of_mul_eq_mul_right (by positivity) e

/-- E2, in ℤ: the quadratic is the Pell equation `(5k+4)² − 5(2u − k)² = −4` with `u = m − k`. -/
private theorem e849_adjacent_pell (m k : ℕ) (hk : k ≤ m) (h : (m + 1) * (k + 1) = (m - k) * (m + 1 - k)) :
    ((5 * k + 4 : ℤ)) ^ 2 - 5 * (2 * ((m : ℤ) - k) - k) ^ 2 = -4 := by
  obtain ⟨u, rfl⟩ : ∃ u, m = u + k := ⟨m - k, by omega⟩
  have h' : (u + k + 1) * (k + 1) = u * (u + 1) := by
    have e1 : u + k - k = u := by omega
    have e2 : u + k + 1 - k = u + 1 := by omega
    rw [e1, e2] at h; exact h
  have hz : ((u : ℤ) + k + 1) * (k + 1) = u * (u + 1) := by exact_mod_cast h'
  push_cast
  nlinarith [hz]



private theorem e849_pell_parity (X Y : ℤ) (h : X ^ 2 - 5 * Y ^ 2 = -4) : 2 ∣ X - Y := by
  rcases Int.even_or_odd X with ⟨p, hp⟩ | ⟨p, hp⟩ <;> rcases Int.even_or_odd Y with ⟨q, hq⟩ | ⟨q, hq⟩
  · exact ⟨p - q, by omega⟩
  · exfalso; subst hp; subst hq
    have : (p + p) ^ 2 - 5 * (2 * q + 1) ^ 2 = 4 * (p ^ 2 - 5 * q ^ 2 - 5 * q) - 5 := by ring
    omega
  · exfalso; subst hp; subst hq
    have : (2 * p + 1) ^ 2 - 5 * (q + q) ^ 2 = 4 * (p ^ 2 + p - 5 * q ^ 2) + 1 := by ring
    omega
  · exact ⟨p - q, by omega⟩

/-- Descent: a solution with Y ≥ 2 comes from a smaller one by the step. -/
private theorem e849_pell_descent (X Y : ℤ) (hX : 0 ≤ X) (hY : 2 ≤ Y) (h : X ^ 2 - 5 * Y ^ 2 = -4) :
    ∃ X' Y' : ℤ, 0 ≤ X' ∧ 0 ≤ Y' ∧ Y' < Y ∧ X' ^ 2 - 5 * Y' ^ 2 = -4 ∧
      X = (3 * X' + 5 * Y') / 2 ∧ Y = (X' + 3 * Y') / 2 := by
  obtain ⟨d, hd⟩ := e849_pell_parity X Y h
  -- X = Y + 2d
  have hXd : X = Y + 2 * d := by omega
  refine ⟨(3 * X - 5 * Y) / 2, (3 * Y - X) / 2, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- 3X ≥ 5Y
    have : 5 * Y ≤ 3 * X := by nlinarith
    omega
  · have : X ≤ 3 * Y := by nlinarith
    omega
  · have : Y < X := by nlinarith
    omega
  · have e1 : (3 * X - 5 * Y) / 2 = 3 * d - Y := by omega
    have e2 : (3 * Y - X) / 2 = Y - d := by omega
    rw [e1, e2]; subst hXd; nlinarith [h]
  · have e1 : (3 * X - 5 * Y) / 2 = 3 * d - Y := by omega
    have e2 : (3 * Y - X) / 2 = Y - d := by omega
    rw [e1, e2]; omega
  · have e1 : (3 * X - 5 * Y) / 2 = 3 * d - Y := by omega
    have e2 : (3 * Y - X) / 2 = Y - d := by omega
    rw [e1, e2]; omega

/-- The induction principle for solutions of X² − 5Y² = −4. -/
private theorem e849_pell5_induction (P : ℤ → ℤ → Prop) (h0 : P 1 1)
    (hstep : ∀ a b : ℤ, 0 ≤ a → 0 ≤ b → a ^ 2 - 5 * b ^ 2 = -4 → P a b →
      P ((3 * a + 5 * b) / 2) ((a + 3 * b) / 2)) :
    ∀ X Y : ℤ, 0 ≤ X → 0 ≤ Y → X ^ 2 - 5 * Y ^ 2 = -4 → P X Y := by
  intro X Y hX hY h
  obtain ⟨N, hN⟩ : ∃ N : ℕ, Y ≤ N := ⟨Y.toNat, Int.self_le_toNat Y⟩
  induction N using Nat.strong_induction_on generalizing X Y with
  | _ N ih =>
    rcases lt_or_ge Y 2 with hY2 | hY2
    · -- Y = 0 impossible, Y = 1 gives X = 1
      have hY1 : Y = 1 := by
        rcases (show Y = 0 ∨ Y = 1 by omega) with h0' | h1
        · subst h0'; nlinarith
        · exact h1
      subst hY1
      have hX1 : X = 1 := by nlinarith
      subst hX1; exact h0
    · obtain ⟨X', Y', hX', hY', hlt, h', eX, eY⟩ := e849_pell_descent X Y hX hY2 h
      have hN' : Y' ≤ (Y'.toNat : ℤ) := Int.self_le_toNat Y'
      have hlt' : Y'.toNat < N := by omega
      have := ih Y'.toNat hlt' X' Y' hX' hY' h' hN'
      rw [eX, eY]
      exact hstep X' Y' hX' hY' h' this


private theorem e849_cassini (i : ℕ) :
    ((fib (2 * i) : ℤ)) ^ 2 + (fib (2 * i) : ℤ) * fib (2 * i + 1) - ((fib (2 * i + 1) : ℤ)) ^ 2 = -1 := by
  induction i with
  | zero => simp
  | succ i ih =>
    have h1 : fib (2 * (i + 1)) = fib (2 * i) + fib (2 * i + 1) := by
      rw [show 2 * (i + 1) = 2 * i + 2 by ring, Nat.fib_add_two]
    have h2 : fib (2 * (i + 1) + 1) = fib (2 * i) + 2 * fib (2 * i + 1) := by
      rw [show 2 * (i + 1) + 1 = 2 * i + 1 + 2 by ring, Nat.fib_add_two, show 2 * i + 1 + 1 = 2 * (i + 1) by ring, h1]; ring
    rw [h1, h2]; push_cast; linear_combination ih

/-- The step keeps the Lucas/Fibonacci shape: P a b := ∃ j, a = 2F_{2j+2} − F_{2j+1} ∧ b = F_{2j+1}. -/
private theorem e849_lucas_step (j : ℕ) :
    (3 * (2 * (fib (2 * j + 2) : ℤ) - fib (2 * j + 1)) + 5 * (fib (2 * j + 1) : ℤ)) / 2
        = 2 * (fib (2 * (j + 1) + 2) : ℤ) - fib (2 * (j + 1) + 1) ∧
    ((2 * (fib (2 * j + 2) : ℤ) - fib (2 * j + 1)) + 3 * (fib (2 * j + 1) : ℤ)) / 2
        = (fib (2 * (j + 1) + 1) : ℤ) := by
  have h3 : fib (2 * (j + 1) + 1) = fib (2 * j + 1) + fib (2 * j + 2) := by
    rw [show 2 * (j + 1) + 1 = 2 * j + 1 + 2 by ring, Nat.fib_add_two]
  have h4 : fib (2 * (j + 1) + 2) = fib (2 * j + 2) + fib (2 * (j + 1) + 1) := by
    rw [show 2 * (j + 1) + 2 = 2 * j + 2 + 2 by ring, Nat.fib_add_two, show 2 * j + 2 + 1 = 2 * (j + 1) + 1 by ring]
  rw [h4, h3]; push_cast; constructor <;> omega

/-- L_{2j+1} mod 5 is 1 for even j and 4 for odd j. -/
private theorem e849_lucas_mod5 (i : ℕ) :
    (2 * (fib (2 * (2 * i) + 2) : ℤ) - fib (2 * (2 * i) + 1)) % 5 = 1 ∧
    (2 * (fib (2 * (2 * i + 1) + 2) : ℤ) - fib (2 * (2 * i + 1) + 1)) % 5 = 4 := by
  induction i with
  | zero => simp [Nat.fib_add_two]
  | succ i ih =>
    -- write every index in terms of x = F_{4i}, y = F_{4i+1}
    set x : ℤ := (fib (4 * i) : ℤ) with hx
    set y : ℤ := (fib (4 * i + 1) : ℤ) with hy
    have f2 : (fib (4 * i + 2) : ℤ) = x + y := by rw [Nat.fib_add_two]; push_cast; ring
    have f3 : (fib (4 * i + 3) : ℤ) = x + 2 * y := by rw [Nat.fib_add_two]; push_cast; rw [f2]; ring
    have f4 : (fib (4 * i + 4) : ℤ) = 2 * x + 3 * y := by rw [Nat.fib_add_two]; push_cast; rw [f2, f3]; ring
    have f5 : (fib (4 * i + 5) : ℤ) = 3 * x + 5 * y := by rw [Nat.fib_add_two]; push_cast; rw [f3, f4]; ring
    have f6 : (fib (4 * i + 6) : ℤ) = 5 * x + 8 * y := by rw [Nat.fib_add_two]; push_cast; rw [f4, f5]; ring
    have f7 : (fib (4 * i + 7) : ℤ) = 8 * x + 13 * y := by rw [Nat.fib_add_two]; push_cast; rw [f5, f6]; ring
    have e1 : 2 * (2 * i) + 2 = 4 * i + 2 := by ring
    have e2 : 2 * (2 * i) + 1 = 4 * i + 1 := by ring
    have e3 : 2 * (2 * i + 1) + 2 = 4 * i + 4 := by ring
    have e4 : 2 * (2 * i + 1) + 1 = 4 * i + 3 := by ring
    have e5 : 2 * (2 * (i + 1)) + 2 = 4 * i + 6 := by ring
    have e6 : 2 * (2 * (i + 1)) + 1 = 4 * i + 5 := by ring
    have e7 : 2 * (2 * (i + 1) + 1) + 2 = 4 * i + 8 := by ring
    have e8 : 2 * (2 * (i + 1) + 1) + 1 = 4 * i + 7 := by ring
    have f8 : (fib (4 * i + 8) : ℤ) = 13 * x + 21 * y := by rw [Nat.fib_add_two]; push_cast; rw [f6, f7]; ring
    rw [e1, e2, e3, e4] at ih
    rw [e5, e6, e7, e8, f5, f6, f7, f8]
    rw [f2, f3, f4] at ih
    omega

/-- The Lind indices: for j = 2i+1, L_{4i+3} = 5·F_{2i}F_{2i+3} + 4 and F_{4i+3} = 2F_{2i+2}F_{2i+3} − 3F_{2i}F_{2i+3} − 2. -/
private theorem e849_lind (i : ℕ) :
    2 * (fib (4 * i + 4) : ℤ) - fib (4 * i + 3) = 5 * (fib (2 * i) : ℤ) * fib (2 * i + 3) + 4 ∧
    (fib (4 * i + 3) : ℤ) = 2 * (fib (2 * i + 2) : ℤ) * fib (2 * i + 3) - 3 * (fib (2 * i) : ℤ) * fib (2 * i + 3) - 2 := by
  have c := e849_cassini i
  set x : ℤ := (fib (2 * i) : ℤ) with hx
  set y : ℤ := (fib (2 * i + 1) : ℤ) with hy
  have f2 : (fib (2 * i + 2) : ℤ) = x + y := by rw [Nat.fib_add_two]; push_cast; ring
  have f3 : (fib (2 * i + 3) : ℤ) = x + 2 * y := by rw [Nat.fib_add_two]; push_cast; rw [f2]; ring
  have g3 : (fib (4 * i + 3) : ℤ) = x * (x + y) + y * (x + 2 * y) := by
    rw [show 4 * i + 3 = 2 * i + (2 * i + 2) + 1 by ring, Nat.fib_add]; push_cast
    rw [f2, show 2 * i + 2 + 1 = 2 * i + 3 by ring, f3]
  have g4 : (fib (4 * i + 4) : ℤ) = y * (x + y) + (x + y) * (x + 2 * y) := by
    rw [show 4 * i + 4 = (2 * i + 1) + (2 * i + 2) + 1 by ring, Nat.fib_add]; push_cast
    rw [show 2 * i + 1 + 1 = 2 * i + 2 by ring, show 2 * i + 2 + 1 = 2 * i + 3 by ring, f2, f3, ← hy]
  rw [g3, g4, f2, f3]
  constructor
  · linear_combination (-4) * c
  · linear_combination 2 * c

theorem variant_3969f1f7__h2__h1__h2 : ∀ (n k m l : ℕ),
  (2 : ℕ) ≤ k →
    (2 : ℕ) * k ≤ n →
      (2 : ℕ) ≤ l →
        (2 : ℕ) * l ≤ m →
          k < l →
            n.choose k = m.choose l →
              m + (1 : ℕ) = n →
                l = k + (1 : ℕ) →
                  ∃ (i : ℕ),
                    (1 : ℕ) ≤ i ∧
                      n = Nat.fib ((2 : ℕ) * i + (2 : ℕ)) * Nat.fib ((2 : ℕ) * i + (3 : ℕ)) ∧
                        k = Nat.fib ((2 : ℕ) * i) * Nat.fib ((2 : ℕ) * i + (3 : ℕ)) ∧ m + (1 : ℕ) = n ∧ l = k + (1 : ℕ) := by
  intro n k m l hk2 hkn hl2 hlm hkl hcoll hmn hlk
  subst hlk
  subst hmn
  have hkm : k ≤ m := by omega
  have hq := (e849_adjacent_iff m k hkm).mp hcoll
  have hp := e849_adjacent_pell m k hkm hq
  have hY0 : (0 : ℤ) ≤ 2 * ((m : ℤ) - k) - k := by
    have : (2 * k + 2 : ℤ) ≤ m := by exact_mod_cast hlm
    linarith
  have key := e849_pell5_induction
    (fun a b => ∃ j : ℕ, a = 2 * (fib (2 * j + 2) : ℤ) - fib (2 * j + 1) ∧ b = (fib (2 * j + 1) : ℤ))
    ⟨0, by simp⟩
    (by
      rintro a b _ _ _ ⟨j, rfl, rfl⟩
      exact ⟨j + 1, (e849_lucas_step j).1, (e849_lucas_step j).2⟩)
    (5 * k + 4) (2 * ((m : ℤ) - k) - k) (by positivity) hY0 hp
  obtain ⟨j, hX, hY⟩ := key
  -- j is odd: L_{2j+1} ≡ 4 (mod 5)
  obtain ⟨i, hi⟩ : ∃ i, j = 2 * i + 1 := by
    rcases Nat.even_or_odd j with ⟨i, hi⟩ | ⟨i, hi⟩
    · exfalso
      have h1 := (e849_lucas_mod5 i).1
      rw [show 2 * i = j by omega] at h1
      rw [← hX] at h1
      omega
    · exact ⟨i, hi⟩
  subst hi
  obtain ⟨l1, l2⟩ := e849_lind i
  rw [show 2 * (2 * i + 1) + 1 = 4 * i + 3 by ring] at hX hY
  rw [show 2 * (2 * i + 1) + 2 = 4 * i + 4 by ring] at hX
  rw [l1] at hX
  rw [l2] at hY
  have hk : (k : ℤ) = (fib (2 * i) : ℤ) * fib (2 * i + 3) := by linarith
  have hn : ((m : ℤ) + 1) = (fib (2 * i + 2) : ℤ) * fib (2 * i + 3) := by linarith
  have hk' : k = fib (2 * i) * fib (2 * i + 3) := by exact_mod_cast hk
  have hn' : m + 1 = fib (2 * i + 2) * fib (2 * i + 3) := by exact_mod_cast hn
  refine ⟨i, ?_, hn', hk', rfl, rfl⟩
  rcases Nat.eq_zero_or_pos i with h0 | h0
  · subst h0; simp at hk'; omega
  · exact h0
