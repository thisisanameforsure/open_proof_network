-- hole: h_pairs
import Mathlib

open Nat

theorem witness : ∃ n k m l : ℕ, 2 ≤ k ∧ 2 * k ≤ n ∧ 2 ≤ l ∧ 2 * l ≤ m ∧ k < l ∧ choose n k = choose m l ∧ ((k = 2 ∧ l = 3) ∨ (k = 2 ∧ l = 4) ∨ (k = 2 ∧ l = 5) ∨ (k = 2 ∧ l = 6) ∨ (k = 2 ∧ l = 8) ∨ (k = 3 ∧ l = 4) ∨ (k = 3 ∧ l = 6) ∨ (k = 4 ∧ l = 6) ∨ (k = 4 ∧ l = 8)) :=
  ⟨16, 2, 10, 3, by norm_num, by norm_num, by norm_num, by norm_num, by norm_num, by decide, Or.inl ⟨rfl, rfl⟩⟩
