open Nat

/-! Hole `h_dw` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem variant_3969f1f7__h2__h1 : ∀ (n k m l : ℕ),
  (2 : ℕ) ≤ k →
    (2 : ℕ) * k ≤ n →
      (2 : ℕ) ≤ l →
        (2 : ℕ) * l ≤ m →
          k < l →
            n.choose k = m.choose l →
              (n = (78 : ℕ) ∧ k = (2 : ℕ) ∧ m = (15 : ℕ) ∧ l = (5 : ℕ) ∨
                  n = (78 : ℕ) ∧ k = (2 : ℕ) ∧ m = (14 : ℕ) ∧ l = (6 : ℕ) ∨
                    n = (16 : ℕ) ∧ k = (2 : ℕ) ∧ m = (10 : ℕ) ∧ l = (3 : ℕ) ∨
                      n = (21 : ℕ) ∧ k = (2 : ℕ) ∧ m = (10 : ℕ) ∧ l = (4 : ℕ) ∨
                        n = (56 : ℕ) ∧ k = (2 : ℕ) ∧ m = (22 : ℕ) ∧ l = (3 : ℕ) ∨
                          n = (120 : ℕ) ∧ k = (2 : ℕ) ∧ m = (36 : ℕ) ∧ l = (3 : ℕ) ∨
                            n = (153 : ℕ) ∧ k = (2 : ℕ) ∧ m = (19 : ℕ) ∧ l = (5 : ℕ) ∨
                              n = (221 : ℕ) ∧ k = (2 : ℕ) ∧ m = (17 : ℕ) ∧ l = (8 : ℕ)) ∨
                ∃ (i : ℕ),
                  (1 : ℕ) ≤ i ∧
                    n = Nat.fib ((2 : ℕ) * i + (2 : ℕ)) * Nat.fib ((2 : ℕ) * i + (3 : ℕ)) ∧
                      k = Nat.fib ((2 : ℕ) * i) * Nat.fib ((2 : ℕ) * i + (3 : ℕ)) ∧ m + (1 : ℕ) = n ∧ l = k + (1 : ℕ) := by
  -- approach: split de Weger's conjecture into what is proved (Blokhuis–Brouwer–de Weger 2017, Theorem 2.2: the nine solved pairs (k,l), the adjacent shape, and all n ≤ 10^6) and the one open remainder; the assembly is the case split
  -- licence: CC-BY-4.0
  have hall :
      (∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
        ((k = 2 ∧ l = 3) ∨ (k = 2 ∧ l = 4) ∨ (k = 2 ∧ l = 5) ∨ (k = 2 ∧ l = 6) ∨ (k = 2 ∧ l = 8) ∨
         (k = 3 ∧ l = 4) ∨ (k = 3 ∧ l = 6) ∨ (k = 4 ∧ l = 6) ∨ (k = 4 ∧ l = 8)) →
        ((n = 78 ∧ k = 2 ∧ m = 15 ∧ l = 5) ∨ (n = 78 ∧ k = 2 ∧ m = 14 ∧ l = 6) ∨
         (n = 16 ∧ k = 2 ∧ m = 10 ∧ l = 3) ∨ (n = 21 ∧ k = 2 ∧ m = 10 ∧ l = 4) ∨
         (n = 56 ∧ k = 2 ∧ m = 22 ∧ l = 3) ∨ (n = 120 ∧ k = 2 ∧ m = 36 ∧ l = 3) ∨
         (n = 153 ∧ k = 2 ∧ m = 19 ∧ l = 5) ∨ (n = 221 ∧ k = 2 ∧ m = 17 ∧ l = 8))) ∧
      (∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
        m + 1 = n → l = k + 1 →
        ∃ i : ℕ, 1 ≤ i ∧ n = fib (2 * i + 2) * fib (2 * i + 3) ∧ k = fib (2 * i) * fib (2 * i + 3) ∧
          m + 1 = n ∧ l = k + 1) ∧
      (∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
        n ≤ 1000000 →
        ((n = 78 ∧ k = 2 ∧ m = 15 ∧ l = 5) ∨ (n = 78 ∧ k = 2 ∧ m = 14 ∧ l = 6) ∨
         (n = 16 ∧ k = 2 ∧ m = 10 ∧ l = 3) ∨ (n = 21 ∧ k = 2 ∧ m = 10 ∧ l = 4) ∨
         (n = 56 ∧ k = 2 ∧ m = 22 ∧ l = 3) ∨ (n = 120 ∧ k = 2 ∧ m = 36 ∧ l = 3) ∨
         (n = 153 ∧ k = 2 ∧ m = 19 ∧ l = 5) ∨ (n = 221 ∧ k = 2 ∧ m = 17 ∧ l = 8)) ∨
        ∃ i : ℕ, 1 ≤ i ∧ n = fib (2 * i + 2) * fib (2 * i + 3) ∧ k = fib (2 * i) * fib (2 * i + 3) ∧
          m + 1 = n ∧ l = k + 1) ∧
      (∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
        ((k = 2 ∧ l = 3) ∨ (k = 2 ∧ l = 4) ∨ (k = 2 ∧ l = 5) ∨ (k = 2 ∧ l = 6) ∨ (k = 2 ∧ l = 8) ∨
         (k = 3 ∧ l = 4) ∨ (k = 3 ∧ l = 6) ∨ (k = 4 ∧ l = 6) ∨ (k = 4 ∧ l = 8)) ∨
        (m + 1 = n ∧ l = k + 1) ∨ n ≤ 1000000) := by
    refine ⟨?_, ?_, ?_, ?_⟩
    ·
      -- label: the nine solved pairs (k, l)
      -- claim: $\binom{n}{k} = \binom{m}{l},\ 2 \le k \le n/2,\ 2 \le l \le m/2,\ k < l,\ (k,l) \in \{(2,3),(2,4),(2,5),(2,6),(2,8),(3,4),(3,6),(4,6),(4,8)\} \Rightarrow (n,k,m,l) \in \{(78,2,15,5), (78,2,14,6), (16,2,10,3), (21,2,10,4), (56,2,22,3), (120,2,36,3), (153,2,19,5), (221,2,17,8)\}$
      -- Known: for each of these pairs the collision equation is a curve of positive genus solved completely:
      -- (2,3) Avanesov, Acta Arith. 12 (1966) 409–420; (2,4) Pintér, Publ. Math. Debrecen 47 (1995) 411–415 and de Weger,
      -- Quart. J. Math. Oxford (2) 47 (1996) 221–231; (2,5) Bugeaud, Mignotte, Siksek, Stoll, Tengely, Algebra Number Theory 2
      -- (2008) 859–885; (2,6), (2,8), (3,6), (4,6), (4,8) Stroeker and de Weger, Math. Comp. 68 (1999) 1257–1281; (3,4) Mordell,
      -- Pacific J. Math. 13 (1963) 1347–1351. Collected as Theorem 2.2 of Blokhuis, Brouwer, de Weger, Integers 17 (2017) #A64.
      have h_pairs : ∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
          ((k = 2 ∧ l = 3) ∨ (k = 2 ∧ l = 4) ∨ (k = 2 ∧ l = 5) ∨ (k = 2 ∧ l = 6) ∨ (k = 2 ∧ l = 8) ∨
           (k = 3 ∧ l = 4) ∨ (k = 3 ∧ l = 6) ∨ (k = 4 ∧ l = 6) ∨ (k = 4 ∧ l = 8)) →
          ((n = 78 ∧ k = 2 ∧ m = 15 ∧ l = 5) ∨ (n = 78 ∧ k = 2 ∧ m = 14 ∧ l = 6) ∨
           (n = 16 ∧ k = 2 ∧ m = 10 ∧ l = 3) ∨ (n = 21 ∧ k = 2 ∧ m = 10 ∧ l = 4) ∨
           (n = 56 ∧ k = 2 ∧ m = 22 ∧ l = 3) ∨ (n = 120 ∧ k = 2 ∧ m = 36 ∧ l = 3) ∨
           (n = 153 ∧ k = 2 ∧ m = 19 ∧ l = 5) ∨ (n = 221 ∧ k = 2 ∧ m = 17 ∧ l = 8)) := by
        sorry
      exact h_pairs
    ·
      -- label: adjacent rows: Lind's family
      -- claim: $\binom{n}{k} = \binom{n-1}{k+1}$ with $2 \le k \le n/2,\ 2(k+1) \le n-1 \Rightarrow (n,k) = (F_{2i+2}F_{2i+3},\ F_{2i}F_{2i+3})$ for some $i \ge 1$
      -- Known: Tovey, Fibonacci Quart. 23 (1985) 356–358 (the equation reduces to a Pell equation in Q(√5)); the family is
      -- Lind's, Fibonacci Quart. 6 (1968) 86–93, rediscovered by Singmaster, Fibonacci Quart. 13 (1975) 295–298. Stated as the
      -- case (m,l) = (n−1,k+1) of Theorem 2.2 of Blokhuis, Brouwer, de Weger, Integers 17 (2017) #A64.
      have h_adjacent : ∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
          m + 1 = n → l = k + 1 →
          ∃ i : ℕ, 1 ≤ i ∧ n = fib (2 * i + 2) * fib (2 * i + 3) ∧ k = fib (2 * i) * fib (2 * i + 3) ∧
            m + 1 = n ∧ l = k + 1 := by
        sorry
      exact h_adjacent
    ·
      -- label: rows up to a million
      -- claim: $\binom{n}{k} = \binom{m}{l},\ 2 \le k \le n/2,\ 2 \le l \le m/2,\ k < l,\ n \le 10^6 \Rightarrow (n,k,m,l) \in \{(78,2,15,5), (78,2,14,6), (16,2,10,3), (21,2,10,4), (56,2,22,3), (120,2,36,3), (153,2,19,5), (221,2,17,8)\} \text{ or } (n,k,m,l) = (F_{2i+2}F_{2i+3},\ F_{2i}F_{2i+3},\ F_{2i+2}F_{2i+3}-1,\ F_{2i}F_{2i+3}+1),\ i \ge 1$
      -- Known by computation: Theorem 2.2 of Blokhuis, Brouwer, de Weger, Integers 17 (2017) #A64, "there are no unknown
      -- collisions ... n ≤ 10^6" (an exhaustive search over the rows, §2.1 there); the same theorem also covers every value
      -- C(n,k) ≤ 10^60. Not formalised.
      have h_small : ∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
          n ≤ 1000000 →
          ((n = 78 ∧ k = 2 ∧ m = 15 ∧ l = 5) ∨ (n = 78 ∧ k = 2 ∧ m = 14 ∧ l = 6) ∨
           (n = 16 ∧ k = 2 ∧ m = 10 ∧ l = 3) ∨ (n = 21 ∧ k = 2 ∧ m = 10 ∧ l = 4) ∨
           (n = 56 ∧ k = 2 ∧ m = 22 ∧ l = 3) ∨ (n = 120 ∧ k = 2 ∧ m = 36 ∧ l = 3) ∨
           (n = 153 ∧ k = 2 ∧ m = 19 ∧ l = 5) ∨ (n = 221 ∧ k = 2 ∧ m = 17 ∧ l = 8)) ∨
          ∃ i : ℕ, 1 ≤ i ∧ n = fib (2 * i + 2) * fib (2 * i + 3) ∧ k = fib (2 * i) * fib (2 * i + 3) ∧
            m + 1 = n ∧ l = k + 1 := by
        sorry
      exact h_small
    ·
      -- label: the open core: no other collisions
      -- claim: $\binom{n}{k} = \binom{m}{l},\ 2 \le k \le n/2,\ 2 \le l \le m/2,\ k < l \Rightarrow (k,l) \in \{(2,3),(2,4),(2,5),(2,6),(2,8),(3,4),(3,6),(4,6),(4,8)\} \text{ or } (m,l) = (n-1,\ k+1) \text{ or } n \le 10^6$
      -- Open: this is exactly what remains of de Weger's conjecture after Theorem 2.2 of Blokhuis, Brouwer, de Weger (2017).
      -- Also known but unusable as a hole (no witness): there are no collisions of the shapes (m,l) = (n−1,k+2), (n−2,k+1)
      -- (Stroeker and de Weger, Acta Arith. 87 (1999) 339–365) and none with C(n,k) ≤ 10^60 beyond the list (BBdW §2.2).
      -- Siegel's theorem (Beukers, Shorey, Tijdeman 1999) gives finitely many collisions for each fixed pair (k,l),
      -- ineffectively; nothing published is uniform in (k,l).
      have h_open : ∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
          ((k = 2 ∧ l = 3) ∨ (k = 2 ∧ l = 4) ∨ (k = 2 ∧ l = 5) ∨ (k = 2 ∧ l = 6) ∨ (k = 2 ∧ l = 8) ∨
           (k = 3 ∧ l = 4) ∨ (k = 3 ∧ l = 6) ∨ (k = 4 ∧ l = 6) ∨ (k = 4 ∧ l = 8)) ∨
          (m + 1 = n ∧ l = k + 1) ∨ n ≤ 1000000 := by
        sorry
      exact h_open
  obtain ⟨h_pairs, h_adjacent, h_small, h_open⟩ := hall
  intro n k m l hk hn hl hm hkl hc
  rcases h_open n k m l hk hn hl hm hkl hc with hp | ⟨h1, h2⟩ | hs
  · left; exact h_pairs n k m l hk hn hl hm hkl hc hp
  · right; exact h_adjacent n k m l hk hn hl hm hkl hc h1 h2
  · exact h_small n k m l hk hn hl hm hkl hc hs
