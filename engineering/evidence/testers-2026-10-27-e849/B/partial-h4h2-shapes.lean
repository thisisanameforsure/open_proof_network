import Mathlib
import Nodes.«variant-3969f1f7--h2--h1--h4--h2».Context

open Nat

/-! Hole `h_core` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem variant_3969f1f7__h2__h1__h4__h2 : ∀ (n k m l : ℕ),
  (2 : ℕ) ≤ k →
    (2 : ℕ) * k ≤ n →
      (2 : ℕ) ≤ l →
        (2 : ℕ) * l ≤ m →
          k < l →
            n.choose k = m.choose l →
              (k = (2 : ℕ) ∧ l = (3 : ℕ) ∨
                  k = (2 : ℕ) ∧ l = (4 : ℕ) ∨
                    k = (2 : ℕ) ∧ l = (5 : ℕ) ∨
                      k = (2 : ℕ) ∧ l = (6 : ℕ) ∨
                        k = (2 : ℕ) ∧ l = (8 : ℕ) ∨
                          k = (3 : ℕ) ∧ l = (4 : ℕ) ∨
                            k = (3 : ℕ) ∧ l = (6 : ℕ) ∨ k = (4 : ℕ) ∧ l = (6 : ℕ) ∨ k = (4 : ℕ) ∧ l = (8 : ℕ)) ∨
                m + (1 : ℕ) = n ∧ l = k + (1 : ℕ) ∨ n ≤ (1000000 : ℕ) ∨ n.choose k ≤ (10 : ℕ) ^ (60 : ℕ) := by
  -- approach: peel the last proved case of Blokhuis–Brouwer–de Weger's Theorem 2.2 (Stroeker–de Weger 1999: no collisions of the shapes (n−1,k+2) and (n−2,k+1)) off the open core; the assembly is the case split
  -- licence: CC-BY-4.0
  have hall :
      (∀ n k : ℕ, 2 ≤ k → 2 * (k + 2) + 1 ≤ n → choose n k ≠ choose (n - 1) (k + 2)) ∧
      (∀ n k : ℕ, 2 ≤ k → 2 * (k + 1) + 2 ≤ n → choose n k ≠ choose (n - 2) (k + 1)) ∧
      (∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
        ((k = 2 ∧ l = 3) ∨ (k = 2 ∧ l = 4) ∨ (k = 2 ∧ l = 5) ∨ (k = 2 ∧ l = 6) ∨ (k = 2 ∧ l = 8) ∨
           (k = 3 ∧ l = 4) ∨ (k = 3 ∧ l = 6) ∨ (k = 4 ∧ l = 6) ∨ (k = 4 ∧ l = 8)) ∨
        (m + 1 = n ∧ l = k + 1) ∨ n ≤ 1000000 ∨ choose n k ≤ 10 ^ 60 ∨
        (m + 1 = n ∧ l = k + 2) ∨ (m + 2 = n ∧ l = k + 1)) := by
    refine ⟨?_, ?_, ?_⟩
    ·
      -- label: no collision of shape (n−1, k+2)
      -- claim: $2 \le k,\ 2(k+2) \le n-1 \Rightarrow \binom{n}{k} \ne \binom{n-1}{k+2}$
      -- Known: Stroeker and de Weger, Acta Arith. 87 (1999) 339–365, solve the equation C(n,k) = C(n−1,k+2) completely;
      -- stated as the case (m,l) = (n−1,k+2) of Theorem 2.2 of Blokhuis, Brouwer, de Weger, Integers 17 (2017) #A64
      -- ("no unknown collisions"; none is known of this shape). Not formalised.
      have h_shape12 : ∀ n k : ℕ, 2 ≤ k → 2 * (k + 2) + 1 ≤ n → choose n k ≠ choose (n - 1) (k + 2) := by
        sorry
      exact h_shape12
    ·
      -- label: no collision of shape (n−2, k+1)
      -- claim: $2 \le k,\ 2(k+1) \le n-2 \Rightarrow \binom{n}{k} \ne \binom{n-2}{k+1}$
      -- Known: Stroeker and de Weger, Acta Arith. 87 (1999) 339–365, solve the equation C(n,k) = C(n−2,k+1) completely;
      -- the case (m,l) = (n−2,k+1) of Theorem 2.2 of Blokhuis, Brouwer, de Weger (2017). Not formalised.
      have h_shape21 : ∀ n k : ℕ, 2 ≤ k → 2 * (k + 1) + 2 ≤ n → choose n k ≠ choose (n - 2) (k + 1) := by
        sorry
      exact h_shape21
    ·
      -- label: the open core: no other collisions
      -- claim: $\binom{n}{k} = \binom{m}{l},\ 2 \le k \le n/2,\ 2 \le l \le m/2,\ k < l \Rightarrow (k,l) \in \{(2,3),(2,4),(2,5),(2,6),(2,8),(3,4),(3,6),(4,6),(4,8)\} \text{ or } (m,l) \in \{(n-1,k+1), (n-1,k+2), (n-2,k+1)\} \text{ or } n \le 10^6 \text{ or } \binom{n}{k} \le 10^{60}$
      -- Open: de Weger's conjecture (BBdW Conjecture 2.1) with every case of Theorem 2.2 removed from its scope; nothing
      -- published is left to peel. Siegel's theorem (Beukers, Shorey, Tijdeman 1999) gives finitely many collisions per fixed
      -- pair (k,l), ineffectively; a bound uniform in (k,l) is what is missing.
      have h_core : ∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
          ((k = 2 ∧ l = 3) ∨ (k = 2 ∧ l = 4) ∨ (k = 2 ∧ l = 5) ∨ (k = 2 ∧ l = 6) ∨ (k = 2 ∧ l = 8) ∨
           (k = 3 ∧ l = 4) ∨ (k = 3 ∧ l = 6) ∨ (k = 4 ∧ l = 6) ∨ (k = 4 ∧ l = 8)) ∨
          (m + 1 = n ∧ l = k + 1) ∨ n ≤ 1000000 ∨ choose n k ≤ 10 ^ 60 ∨
          (m + 1 = n ∧ l = k + 2) ∨ (m + 2 = n ∧ l = k + 1) := by
        sorry
      exact h_core
  obtain ⟨h12, h21, h_core⟩ := hall
  intro n k m l hk hn hl hm hkl hc
  rcases h_core n k m l hk hn hl hm hkl hc with hp | ha | hs | hv | ⟨h1, h2⟩ | ⟨h1, h2⟩
  · left; exact hp
  · right; left; exact ha
  · right; right; left; exact hs
  · right; right; right; exact hv
  · exfalso
    have hm' : m = n - 1 := by omega
    subst h2
    rw [hm'] at hc
    exact h12 n k hk (by omega) hc
  · exfalso
    have hm' : m = n - 2 := by omega
    subst h2
    rw [hm'] at hc
    exact h21 n k hk (by omega) hc
