theorem variant_3969f1f7__h2__h1__h4 : ∀ (n k m l : ℕ),
  (2 : ℕ) ≤ k →
    (2 : ℕ) * k ≤ n →
      (2 : ℕ) ≤ l →
        (2 : ℕ) * l ≤ m →
          k < l →
            n.choose k = m.choose l →
              (k = (2 : ℕ) ∧ l = (3 : ℕ) ∨
                  k = (2 : ℕ) ∧ l = (4 : ℕ) ∨
                    k = (2 : ℕ) ∧ l = (5 : ℕ) ∨
                      k = (2 : ℕ) ∧ l = (6 : ℕ) ∨
                        k = (2 : ℕ) ∧ l = (8 : ℕ) ∨
                          k = (3 : ℕ) ∧ l = (4 : ℕ) ∨
                            k = (3 : ℕ) ∧ l = (6 : ℕ) ∨ k = (4 : ℕ) ∧ l = (6 : ℕ) ∨ k = (4 : ℕ) ∧ l = (8 : ℕ)) ∨
                m + (1 : ℕ) = n ∧ l = k + (1 : ℕ) ∨ n ≤ (1000000 : ℕ) := by
  -- approach: peel the last proved piece of Blokhuis–Brouwer–de Weger's Theorem 2.2 (every collision with C(n,k) ≤ 10^60 is known) off the open remainder; the assembly is the case split
  -- licence: CC-BY-4.0
  have hall :
      (∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
        choose n k ≤ 10 ^ 60 →
        ((n = 78 ∧ k = 2 ∧ m = 15 ∧ l = 5) ∨ (n = 78 ∧ k = 2 ∧ m = 14 ∧ l = 6) ∨
           (n = 16 ∧ k = 2 ∧ m = 10 ∧ l = 3) ∨ (n = 21 ∧ k = 2 ∧ m = 10 ∧ l = 4) ∨
           (n = 56 ∧ k = 2 ∧ m = 22 ∧ l = 3) ∨ (n = 120 ∧ k = 2 ∧ m = 36 ∧ l = 3) ∨
           (n = 153 ∧ k = 2 ∧ m = 19 ∧ l = 5) ∨ (n = 221 ∧ k = 2 ∧ m = 17 ∧ l = 8)) ∨
        ∃ i : ℕ, 1 ≤ i ∧ n = fib (2 * i + 2) * fib (2 * i + 3) ∧ k = fib (2 * i) * fib (2 * i + 3) ∧
            m + 1 = n ∧ l = k + 1) ∧
      (∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
        ((k = 2 ∧ l = 3) ∨ (k = 2 ∧ l = 4) ∨ (k = 2 ∧ l = 5) ∨ (k = 2 ∧ l = 6) ∨ (k = 2 ∧ l = 8) ∨
           (k = 3 ∧ l = 4) ∨ (k = 3 ∧ l = 6) ∨ (k = 4 ∧ l = 6) ∨ (k = 4 ∧ l = 8)) ∨
        (m + 1 = n ∧ l = k + 1) ∨ n ≤ 1000000 ∨ choose n k ≤ 10 ^ 60) := by
    refine ⟨?_, ?_⟩
    ·
      -- label: values up to 10^60
      -- claim: $\binom{n}{k} = \binom{m}{l} \le 10^{60},\ 2 \le k \le n/2,\ 2 \le l \le m/2,\ k < l \Rightarrow (n,k,m,l) \in \{(78,2,15,5), (78,2,14,6), (16,2,10,3), (21,2,10,4), (56,2,22,3), (120,2,36,3), (153,2,19,5), (221,2,17,8)\} \text{ or } (n,k,m,l) = (F_{2i+2}F_{2i+3},\ F_{2i}F_{2i+3},\ F_{2i+2}F_{2i+3}-1,\ F_{2i}F_{2i+3}+1),\ i \ge 1$
      -- Known by computation: Theorem 2.2 of Blokhuis, Brouwer, de Weger, Integers 17 (2017) #A64, case C(n,k) ≤ 10^60, by the
      -- sieve of §2.2 there (all primes below 500, about 375 CPU hours). Earlier: C(n,k) ≤ 10^30, de Weger, J. Number Theory 63
      -- (1997) 373–386. Not formalised.
      have h_value : ∀ n k m l : ℕ, 2 ≤ k → 2 * k ≤ n → 2 ≤ l → 2 * l ≤ m → k < l → choose n k = choose m l →
          choose n k ≤ 10 ^ 60 →
          ((n = 78 ∧ k = 2 ∧ m = 15 ∧ l = 5) ∨ (n = 78 ∧ k = 2 ∧ m = 14 ∧ l = 6) ∨
           (n = 16 ∧ k = 2 ∧ m = 10 ∧ l = 3) ∨ (n = 21 ∧ k = 2 ∧ m = 10 ∧ l = 4) ∨
           (n = 56 ∧ k = 2 ∧ m = 22 ∧ l = 3) ∨ (n = 120 ∧ k = 2 ∧ m = 36 ∧ l = 3) ∨
           (n = 153 ∧ k = 2 ∧ m = 19 ∧ l = 5) ∨ (n = 221 ∧ k = 2 ∧ m = 17 ∧ l = 8)) ∨
          ∃ i : ℕ, 1 ≤ i ∧ n = fib (2 * i + 2) * fib (2 * i + 3) ∧ k = fib (2 * i) * fib (2 * i + 3) ∧
            m + 1 = n ∧ l = k + 1 := by
        sorry
