open Nat

/-! Hole `h_fixed` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private theorem choose_lt_succ_n (j n : ℕ) (h : j ≤ n) : choose n (j + 1) < choose (n + 1) (j + 1) := by
  rw [Nat.choose_succ_succ']
  have : 0 < choose n j := Nat.choose_pos h
  omega

private theorem choose_strict_n (j n : ℕ) (hjn : j ≤ n) : ∀ m, n < m → choose n (j + 1) < choose m (j + 1) := by
  intro m
  induction m with
  | zero => intro h; omega
  | succ m ih =>
    intro h
    rcases Nat.lt_succ_iff_lt_or_eq.mp h with h' | h'
    · exact lt_trans (ih h') (choose_lt_succ_n j m (by omega))
    · subst h'; exact choose_lt_succ_n j n hjn


theorem variant_3969f1f7__h1 : ∀ (K a : ℕ), {n : ℕ | ∃ (k : ℕ), (2 : ℕ) ≤ k ∧ k ≤ K ∧ (2 : ℕ) * k ≤ n ∧ n.choose k = a}.ncard ≤ K := by
  intro K a
  classical
  set R := {n : ℕ | ∃ k : ℕ, 2 ≤ k ∧ k ≤ K ∧ 2 * k ≤ n ∧ choose n k = a} with hR
  let f : ℕ → ℕ := fun n =>
    if h : ∃ k : ℕ, 2 ≤ k ∧ k ≤ K ∧ 2 * k ≤ n ∧ choose n k = a then h.choose else 0
  have hf : ∀ n ∈ R, 2 ≤ f n ∧ f n ≤ K ∧ 2 * f n ≤ n ∧ choose n (f n) = a := by
    intro n hn
    have hn' : ∃ k : ℕ, 2 ≤ k ∧ k ≤ K ∧ 2 * k ≤ n ∧ choose n k = a := hn
    simp only [f, dif_pos hn']
    exact hn'.choose_spec
  have hmaps : ∀ n ∈ R, f n ∈ (Finset.Icc 1 K : Set ℕ) := by
    intro n hn
    obtain ⟨h1, h2, -, -⟩ := hf n hn
    simp only [Finset.coe_Icc, Set.mem_Icc]
    omega
  have hinj : Set.InjOn f R := by
    intro n hn m hm hnm
    obtain ⟨h1, -, h2, h3⟩ := hf n hn
    obtain ⟨g1, -, g2, g3⟩ := hf m hm
    by_contra hne
    obtain ⟨j, hj⟩ : ∃ j, f n = j + 1 := ⟨f n - 1, by omega⟩
    rcases lt_or_gt_of_ne hne with hlt | hlt
    · have := choose_strict_n j n (by omega) m hlt
      rw [← hj, hnm, g3, ← hnm, h3] at this
      exact lt_irrefl _ this
    · have := choose_strict_n j m (by omega) n hlt
      rw [← hj, hnm, g3] at this
      rw [← hnm, h3] at this
      exact lt_irrefl _ this
  have := Set.ncard_le_ncard_of_injOn f hmaps hinj (Finset.finite_toSet _)
  simpa using this
