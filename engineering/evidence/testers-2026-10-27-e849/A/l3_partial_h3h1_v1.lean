open Nat

/-! Hole `h_dist` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem variant_3969f1f7__h3__h1 : ∃ (a₁ : ℕ),
  ∀ a ≥ a₁,
    ∀ (n k n' k' : ℕ),
      (1 : ℕ) ≤ k ∧ Real.exp (Real.log (↑n : ℝ) ^ (5 / 6 : ℝ)) ≤ (↑k : ℝ) ∧ (2 : ℕ) * k ≤ n ∧ n.choose k = a →
        (1 : ℕ) ≤ k' ∧ Real.exp (Real.log (↑n' : ℝ) ^ (5 / 6 : ℝ)) ≤ (↑k' : ℝ) ∧ (2 : ℕ) * k' ≤ n' ∧ n'.choose k' = a →
          |(↑n : ℝ) - (↑n' : ℝ)| + |(↑k : ℝ) - (↑k' : ℝ)| ≤ Real.exp (Real.log (Real.log (↑a : ℝ)) ^ (9 / 10 : ℝ)) := by
  -- approach: MRSTT 2022 §1.2 — Proposition 1.9 (distance estimate) with ε = 1/20, the elementary size bounds (1.5), (1.7) for an interior solution, and one real-analysis lemma absorbing the implied constant for a large
  -- licence: CC-BY-4.0
  have hall :
      (∃ C : ℝ, 0 ≤ C ∧ ∃ a₁ : ℕ, ∀ a ≥ a₁, ∀ n k n' k' : ℕ,
          (1 ≤ k ∧ 2 * k ≤ n ∧ n.choose k = a) → (1 ≤ k' ∧ 2 * k' ≤ n' ∧ n'.choose k' = a) →
          |(k : ℝ) - k'| ≤ C * Real.exp (Real.log ((n : ℝ) + n') ^ (43 / 60 : ℝ)) ∧
          (Real.exp (Real.log ((n : ℝ) + n') ^ (43 / 60 : ℝ)) ≤ k →
            Real.exp (Real.log ((n : ℝ) + n') ^ (43 / 60 : ℝ)) ≤ k' →
            |(n : ℝ) - n'| ≤ C * Real.exp (Real.log ((n : ℝ) + n') ^ (43 / 60 : ℝ)))) ∧
      (∀ a n k : ℕ, 1 ≤ k → 2 * k ≤ n → n.choose k = a →
          Real.log a ≤ k * Real.log n ∧ (3 ≤ k → (k : ℝ) ≤ 2 * Real.log a) ∧
          (Real.exp (Real.log (n : ℝ) ^ (5 / 6 : ℝ)) ≤ (k : ℝ) →
            3 ≤ k ∧ Real.log n ≤ Real.log k ^ (6 / 5 : ℝ))) ∧
      (∀ C : ℝ, ∃ X₀ : ℝ, ∀ X ≥ X₀,
          (1 + (X + 1) ^ (6 / 5 : ℝ)) ^ (43 / 60 : ℝ) ≤ X - 6 / 5 * Real.log (X + 1) ∧
          C * Real.exp ((1 + (X + 1) ^ (6 / 5 : ℝ)) ^ (43 / 60 : ℝ)) ≤ Real.exp (X ^ (9 / 10 : ℝ))) := by
    refine ⟨?_, ?_, ?_⟩
    ·
      -- label: distance estimate for two solutions (MRSTT Prop 1.9)
      -- claim: $\exists C \ge 0\ \exists a_1\ \forall a \ge a_1$: two solutions $(n,k),(n',k')$ of $\binom{n}{k}=a$ in the left half satisfy
      -- $|k-k'| \le C e^{(\log(n+n'))^{43/60}}$, and $|n-n'| \le C e^{(\log(n+n'))^{43/60}}$ when both $k, k' \ge e^{(\log(n+n'))^{43/60}}$
      -- Matomäki, Radziwiłł, Shao, Tao, Teräväinen, Quart. J. Math. 73 (2022), Proposition 1.9 with ε = 1/20
      -- (2/3 + 1/20 = 43/60); the ≪_ε is the constant C, "t sufficiently large" is a₁. Deep: rests on the
      -- equidistribution estimate Proposition 1.12 (their §3, §4).
      have h_prop19 : ∃ C : ℝ, 0 ≤ C ∧ ∃ a₁ : ℕ, ∀ a ≥ a₁, ∀ n k n' k' : ℕ,
          (1 ≤ k ∧ 2 * k ≤ n ∧ n.choose k = a) → (1 ≤ k' ∧ 2 * k' ≤ n' ∧ n'.choose k' = a) →
          |(k : ℝ) - k'| ≤ C * Real.exp (Real.log ((n : ℝ) + n') ^ (43 / 60 : ℝ)) ∧
          (Real.exp (Real.log ((n : ℝ) + n') ^ (43 / 60 : ℝ)) ≤ k →
            Real.exp (Real.log ((n : ℝ) + n') ^ (43 / 60 : ℝ)) ≤ k' →
            |(n : ℝ) - n'| ≤ C * Real.exp (Real.log ((n : ℝ) + n') ^ (43 / 60 : ℝ))) := by
        sorry
      exact h_prop19
    ·
      -- label: size of an interior solution ((1.5), (1.7))
      -- claim: $\log a \le k \log n,\quad 3 \le k \Rightarrow k \le 2\log a,\quad e^{(\log n)^{5/6}} \le k \Rightarrow (k \ge 3 \wedge \log n \le (\log k)^{6/5})$ for a left-half solution $(n,k)$ of $\binom{n}{k}=a$
      -- Elementary: k ≤ 2 forces n ≤ 1 under the threshold; 2^k ≤ C(2k,k) ≤ C(n,k) = a gives k ≤ 2 log a;
      -- a = C(n,k) ≤ n^k gives log a ≤ k log n; the threshold exp((log n)^(5/6)) ≤ k gives log n ≤ (log k)^(6/5).
      have h_size : ∀ a n k : ℕ, 1 ≤ k → 2 * k ≤ n → n.choose k = a →
          Real.log a ≤ k * Real.log n ∧ (3 ≤ k → (k : ℝ) ≤ 2 * Real.log a) ∧
          (Real.exp (Real.log (n : ℝ) ^ (5 / 6 : ℝ)) ≤ (k : ℝ) →
            3 ≤ k ∧ Real.log n ≤ Real.log k ^ (6 / 5 : ℝ)) := by
        sorry
      exact h_size
    ·
      -- label: the implied constant is absorbed for X large
      -- claim: $\forall C\ \exists X_0\ \forall X \ge X_0$: $(1+(X+1)^{6/5})^{43/60} \le X - \tfrac{6}{5}\log(X+1)$ and $C\,e^{(1+(X+1)^{6/5})^{43/60}} \le e^{X^{9/10}}$
      -- Elementary real analysis: (1+(X+1)^(6/5))^(43/60) grows like X^(43/50), slower than X and than X^(9/10).
      have h_absorb : ∀ C : ℝ, ∃ X₀ : ℝ, ∀ X ≥ X₀,
          (1 + (X + 1) ^ (6 / 5 : ℝ)) ^ (43 / 60 : ℝ) ≤ X - 6 / 5 * Real.log (X + 1) ∧
          C * Real.exp ((1 + (X + 1) ^ (6 / 5 : ℝ)) ^ (43 / 60 : ℝ)) ≤ Real.exp (X ^ (9 / 10 : ℝ)) := by
        sorry
      exact h_absorb
  obtain ⟨⟨C, hC0, a₂, hP⟩, hS, hA⟩ := hall
  obtain ⟨X₀, hX⟩ := hA (2 * C)
  refine ⟨max a₂ (⌈Real.exp (Real.exp (max X₀ 0))⌉₊ + 2), fun a ha => ?_⟩
  intro n k n' k' hnk hnk'
  have ha₂ : a₂ ≤ a := le_trans (le_max_left _ _) ha
  have hac : ⌈Real.exp (Real.exp (max X₀ 0))⌉₊ + 2 ≤ a := le_trans (le_max_right _ _) ha
  have haR : Real.exp (Real.exp (max X₀ 0)) ≤ (a : ℝ) := by
    have h1 : Real.exp (Real.exp (max X₀ 0)) ≤ (⌈Real.exp (Real.exp (max X₀ 0))⌉₊ : ℝ) := Nat.le_ceil _
    have h2 : ((⌈Real.exp (Real.exp (max X₀ 0))⌉₊ : ℕ) : ℝ) ≤ (a : ℝ) := by exact_mod_cast (by omega : ⌈Real.exp (Real.exp (max X₀ 0))⌉₊ ≤ a)
    exact h1.trans h2
  have ha_pos : (0 : ℝ) < a := lt_of_lt_of_le (Real.exp_pos _) haR
  have hloga : Real.exp (max X₀ 0) ≤ Real.log a := (Real.le_log_iff_exp_le ha_pos).2 haR
  have hloga_pos : 0 < Real.log a := lt_of_lt_of_le (Real.exp_pos _) hloga
  set X := Real.log (Real.log a) with hXdef
  have hX0 : max X₀ 0 ≤ X := (Real.le_log_iff_exp_le hloga_pos).2 hloga
  have hXX : X₀ ≤ X := le_trans (le_max_left _ _) hX0
  have hXnn : 0 ≤ X := le_trans (le_max_right _ _) hX0
  obtain ⟨hAb1, hAb2⟩ := hX X hXX
  -- the size bounds for both solutions
  obtain ⟨hk1, hkth, hk2, hk4⟩ := hnk
  obtain ⟨hk1', hkth', hk2', hk4'⟩ := hnk'
  obtain ⟨hlogak, hkle0, hth⟩ := hS a n k hk1 hk2 hk4
  obtain ⟨hlogak', hkle0', hth'⟩ := hS a n' k' hk1' hk2' hk4'
  obtain ⟨hk3, hlogn⟩ := hth hkth
  obtain ⟨hk3', hlogn'⟩ := hth' hkth'
  have hkle := hkle0 hk3
  have hkle' := hkle0' hk3'
  have hlog2 : Real.log 2 < 1 := by
    have := Real.log_two_lt_d9; linarith
  -- a generic bound: for an interior solution, log n ≤ (X+1)^(6/5), log k ≥ X - 6/5 log (X+1)
  have gen : ∀ m j : ℕ, 3 ≤ j → (j : ℝ) ≤ 2 * Real.log a → Real.log a ≤ j * Real.log m →
      Real.log m ≤ Real.log j ^ (6 / 5 : ℝ) → 2 * j ≤ m →
      Real.log m ≤ (X + 1) ^ (6 / 5 : ℝ) ∧ X - 6 / 5 * Real.log (X + 1) ≤ Real.log j := by
    intro m j hj3 hjle hlogaj hlogm hjm
    have hjpos : (0 : ℝ) < j := by exact_mod_cast (by omega : 0 < j)
    have hmpos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
    have hlogj_pos : 0 < Real.log j := Real.log_pos (by exact_mod_cast (by omega : 1 < j))
    have hlogm_pos : 0 < Real.log m := Real.log_pos (by exact_mod_cast (by omega : 1 < m))
    have hlogj : Real.log j ≤ X + 1 := by
      have h1 : Real.log j ≤ Real.log (2 * Real.log a) := Real.log_le_log hjpos hjle
      rw [Real.log_mul (by norm_num) hloga_pos.ne'] at h1
      linarith
    have hlogj_nn : 0 ≤ Real.log j := hlogj_pos.le
    constructor
    · calc Real.log m ≤ Real.log j ^ (6 / 5 : ℝ) := hlogm
        _ ≤ (X + 1) ^ (6 / 5 : ℝ) := Real.rpow_le_rpow hlogj_nn hlogj (by norm_num)
    · -- log j ≥ log (log a / log m) = X - log log m ≥ X - 6/5 log (X + 1)
      have hdiv : Real.log a / Real.log m ≤ j := by
        rw [div_le_iff₀ hlogm_pos]; exact hlogaj
      have hdiv_pos : 0 < Real.log a / Real.log m := div_pos hloga_pos hlogm_pos
      have h1 : Real.log (Real.log a / Real.log m) ≤ Real.log j := Real.log_le_log hdiv_pos hdiv
      rw [Real.log_div hloga_pos.ne' hlogm_pos.ne'] at h1
      have h2 : Real.log (Real.log m) ≤ 6 / 5 * Real.log (X + 1) := by
        calc Real.log (Real.log m) ≤ Real.log (Real.log j ^ (6 / 5 : ℝ)) :=
              Real.log_le_log hlogm_pos hlogm
          _ = 6 / 5 * Real.log (Real.log j) := Real.log_rpow hlogj_pos _
          _ ≤ 6 / 5 * Real.log (X + 1) := by
              gcongr
      linarith
  obtain ⟨hn_up, hk_low⟩ := gen n k hk3 hkle hlogak hlogn hk2
  obtain ⟨hn_up', hk_low'⟩ := gen n' k' hk3' hkle' hlogak' hlogn' hk2'
  have hnpos : (0 : ℝ) < n := by exact_mod_cast (by omega : 0 < n)
  have hnpos' : (0 : ℝ) < n' := by exact_mod_cast (by omega : 0 < n')
  -- n + n' ≤ 2 exp((X+1)^(6/5)), so log (n + n') ≤ 1 + (X+1)^(6/5)
  set L := 1 + (X + 1) ^ (6 / 5 : ℝ) with hLdef
  have hlogsum : Real.log ((n : ℝ) + n') ≤ L := by
    have h1 : (n : ℝ) ≤ Real.exp ((X + 1) ^ (6 / 5 : ℝ)) := (Real.log_le_iff_le_exp hnpos).1 hn_up
    have h2 : (n' : ℝ) ≤ Real.exp ((X + 1) ^ (6 / 5 : ℝ)) := (Real.log_le_iff_le_exp hnpos').1 hn_up'
    have h3 : (n : ℝ) + n' ≤ 2 * Real.exp ((X + 1) ^ (6 / 5 : ℝ)) := by linarith
    have h4 : Real.log ((n : ℝ) + n') ≤ Real.log (2 * Real.exp ((X + 1) ^ (6 / 5 : ℝ))) :=
      Real.log_le_log (by positivity) h3
    rw [Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp] at h4
    linarith
  have hlogsum_nn : 0 ≤ Real.log ((n : ℝ) + n') := by
    apply Real.log_nonneg
    have : (1 : ℝ) ≤ n := by exact_mod_cast (by omega : 1 ≤ n)
    linarith
  set E := Real.exp (Real.log ((n : ℝ) + n') ^ (43 / 60 : ℝ)) with hEdef
  have hE : E ≤ Real.exp (L ^ (43 / 60 : ℝ)) := by
    apply Real.exp_le_exp.2
    exact Real.rpow_le_rpow hlogsum_nn hlogsum (by norm_num)
  have hEk : E ≤ k := by
    have hkpos : (0 : ℝ) < k := by exact_mod_cast (by omega : 0 < k)
    calc E ≤ Real.exp (L ^ (43 / 60 : ℝ)) := hE
      _ ≤ Real.exp (X - 6 / 5 * Real.log (X + 1)) := Real.exp_le_exp.2 hAb1
      _ ≤ Real.exp (Real.log k) := Real.exp_le_exp.2 hk_low
      _ = k := Real.exp_log hkpos
  have hEk' : E ≤ k' := by
    have hkpos : (0 : ℝ) < k' := by exact_mod_cast (by omega : 0 < k')
    calc E ≤ Real.exp (L ^ (43 / 60 : ℝ)) := hE
      _ ≤ Real.exp (X - 6 / 5 * Real.log (X + 1)) := Real.exp_le_exp.2 hAb1
      _ ≤ Real.exp (Real.log k') := Real.exp_le_exp.2 hk_low'
      _ = k' := Real.exp_log hkpos
  obtain ⟨hdk, hdn⟩ := hP a ha₂ n k n' k' ⟨hk1, hk2, hk4⟩ ⟨hk1', hk2', hk4'⟩
  have hdn' := hdn hEk hEk'
  calc |(n : ℝ) - n'| + |(k : ℝ) - k'| ≤ C * E + C * E := add_le_add hdn' hdk
    _ = 2 * C * E := by ring
    _ ≤ 2 * C * Real.exp (L ^ (43 / 60 : ℝ)) := by
        apply mul_le_mul_of_nonneg_left hE; linarith
    _ ≤ Real.exp (X ^ (9 / 10 : ℝ)) := hAb2
