import Mathlib
import Nodes.«variant-3969f1f7--h3».Context

open Nat

/-! Hole `h_interior` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem variant_3969f1f7__h3 : ∃ (a₀ : ℕ),
  ∀ a ≥ a₀,
    {n : ℕ |
          ∃ (k : ℕ),
            (1 : ℕ) ≤ k ∧
              Real.exp (Real.log (↑n : ℝ) ^ (5 / 6 : ℝ)) ≤ (↑k : ℝ) ∧ (2 : ℕ) * k ≤ n ∧ n.choose k = a}.ncard ≤
      (2 : ℕ) := by
  -- approach: MRSTT 2022 §1.2 — take the interior solution with the largest k; every other interior solution lies within exp((log log a)^(9/10)) of it (Prop 1.9 with (1.5), (1.7)), and the Kane-type estimate Prop 1.10 allows at most one such neighbour
  -- licence: CC-BY-4.0
  have hall :
      (∃ a₁ : ℕ, ∀ a ≥ a₁, ∀ n k n' k' : ℕ,
          (1 ≤ k ∧ Real.exp (Real.log (n : ℝ) ^ (5 / 6 : ℝ)) ≤ (k : ℝ) ∧ 2 * k ≤ n ∧ n.choose k = a) →
          (1 ≤ k' ∧ Real.exp (Real.log (n' : ℝ) ^ (5 / 6 : ℝ)) ≤ (k' : ℝ) ∧ 2 * k' ≤ n' ∧
            n'.choose k' = a) →
          |(n : ℝ) - n'| + |(k : ℝ) - k'| ≤ Real.exp (Real.log (Real.log (a : ℝ)) ^ (9 / 10 : ℝ))) ∧
      (∃ a₂ : ℕ, ∀ a ≥ a₂, ∀ n k : ℕ,
          (1 ≤ k ∧ Real.exp (Real.log (n : ℝ) ^ (5 / 6 : ℝ)) ≤ (k : ℝ) ∧ 2 * k ≤ n ∧ n.choose k = a) →
          {n' : ℕ | ∃ k' : ℕ, 1 ≤ k' ∧ k' < k ∧ n < n' ∧ 2 * k' ≤ n' ∧ n'.choose k' = a ∧
              |(n : ℝ) - n'| + |(k : ℝ) - k'| ≤
                Real.exp (Real.log (Real.log (a : ℝ)) ^ (9 / 10 : ℝ))}.ncard ≤ 1) := by
    refine ⟨?_, ?_⟩
    ·
      -- label: distance between interior solutions (MRSTT Prop 1.9)
      -- claim: $\exists a_1\ \forall a \ge a_1$: any two solutions $(n,k), (n',k')$ of $\binom{n}{k} = a$ with
      -- $e^{(\log n)^{5/6}} \le k \le n/2$ satisfy $|n-n'| + |k-k'| \le \exp\big((\log\log a)^{9/10}\big)$
      -- Matomäki, Radziwiłł, Shao, Tao, Teräväinen, Quart. J. Math. 73 (2022), §1.2: Proposition 1.9
      -- (distance estimate) combined with the size bounds (1.5), (1.7) gives m − m', n' − n ≪ exp(O((log log t)^{1−ε'}))
      -- for every ε' < ε/(2/3+ε); here ε = 1/6, ε' = 3/20, and the O and the ≪ are absorbed by a₁.
      have h_dist : ∃ a₁ : ℕ, ∀ a ≥ a₁, ∀ n k n' k' : ℕ,
          (1 ≤ k ∧ Real.exp (Real.log (n : ℝ) ^ (5 / 6 : ℝ)) ≤ (k : ℝ) ∧ 2 * k ≤ n ∧ n.choose k = a) →
          (1 ≤ k' ∧ Real.exp (Real.log (n' : ℝ) ^ (5 / 6 : ℝ)) ≤ (k' : ℝ) ∧ 2 * k' ≤ n' ∧
            n'.choose k' = a) →
          |(n : ℝ) - n'| + |(k : ℝ) - k'| ≤ Real.exp (Real.log (Real.log (a : ℝ)) ^ (9 / 10 : ℝ)) := by
        sorry
      exact h_dist
    ·
      -- label: Kane-type estimate (MRSTT Prop 1.10)
      -- claim: $\exists a_2\ \forall a \ge a_2$: for a solution $(n,k)$ of $\binom{n}{k} = a$ with $e^{(\log n)^{5/6}} \le k \le n/2$,
      -- $\#\{n' > n : \binom{n'}{k'} = a,\ 1 \le k' < k,\ 2k' \le n',\ |n-n'| + |k-k'| \le \exp((\log\log a)^{9/10})\} \le 1$
      -- MRSTT Proposition 1.10 with ε = 1/20: at most one other left-half solution (n', m') with m' < m, n' > n and
      -- |m − m'| + |n − n'| ≪ exp((log log t)^{19/20}); c·exp(x^{19/20}) ≥ exp(x^{9/10}) for x large, whatever the
      -- implied constant c, so the hole is implied for a ≥ a₂. Rows n' are at most the solutions.
      have h_kane : ∃ a₂ : ℕ, ∀ a ≥ a₂, ∀ n k : ℕ,
          (1 ≤ k ∧ Real.exp (Real.log (n : ℝ) ^ (5 / 6 : ℝ)) ≤ (k : ℝ) ∧ 2 * k ≤ n ∧ n.choose k = a) →
          {n' : ℕ | ∃ k' : ℕ, 1 ≤ k' ∧ k' < k ∧ n < n' ∧ 2 * k' ≤ n' ∧ n'.choose k' = a ∧
              |(n : ℝ) - n'| + |(k : ℝ) - k'| ≤
                Real.exp (Real.log (Real.log (a : ℝ)) ^ (9 / 10 : ℝ))}.ncard ≤ 1 := by
        sorry
      exact h_kane
  obtain ⟨⟨a₁, hD⟩, ⟨a₂, hK⟩⟩ := hall
  refine ⟨max a₁ a₂, fun a ha => ?_⟩
  have ha₁ : a₁ ≤ a := le_trans (le_max_left _ _) ha
  have ha₂ : a₂ ≤ a := le_trans (le_max_right _ _) ha
  -- rows holding a are at most a
  have key : ∀ n k : ℕ, 1 ≤ k → 2 * k ≤ n → n.choose k = a → n ≤ a := by
    intro n k hk1 hk2 h
    rw [← h]
    calc n = n.choose 1 := (Nat.choose_one_right n).symm
      _ ≤ n.choose k := by
        have hmono : ∀ j, 1 ≤ j → j ≤ n / 2 → n.choose 1 ≤ n.choose j := by
          intro j
          induction j with
          | zero => intro h _; omega
          | succ j ih =>
            intro hr hj
            rcases Nat.eq_or_lt_of_le hr with h' | h'
            · rw [← h']
            · exact (ih (by omega) (by omega)).trans
                (Nat.choose_le_succ_of_lt_half_left (by omega))
        exact hmono k hk1 (by omega)
  -- C(·, k) is strictly increasing in n for 1 ≤ k ≤ n
  have hstrict : ∀ j n m : ℕ, j ≤ n → n < m → n.choose (j + 1) < m.choose (j + 1) := by
    intro j n m hjn hnm
    induction m with
    | zero => omega
    | succ m ih =>
      have hstep : m.choose (j + 1) < (m + 1).choose (j + 1) := by
        rw [Nat.choose_succ_succ']
        have : 0 < m.choose j := Nat.choose_pos (by omega)
        omega
      rcases Nat.lt_succ_iff_lt_or_eq.mp hnm with h' | h'
      · exact lt_trans (ih h') hstep
      · subst h'
        rw [Nat.choose_succ_succ']
        have : 0 < n.choose j := Nat.choose_pos hjn
        omega
  -- C(n, ·) is increasing on the half 0 ≤ i ≤ j ≤ n / 2
  have hhalf : ∀ n i j : ℕ, i ≤ j → j ≤ n / 2 → n.choose i ≤ n.choose j := by
    intro n i j hij hj
    induction j with
    | zero => have : i = 0 := by omega
              rw [this]
    | succ j ih =>
      rcases Nat.eq_or_lt_of_le hij with h' | h'
      · rw [h']
      · exact (ih (by omega) (by omega)).trans (Nat.choose_le_succ_of_lt_half_left (by omega))
  -- the maximal-k step: of two interior rows, the larger row has the smaller k
  have hkk : ∀ n k n' k' : ℕ, 1 ≤ k → 2 * k ≤ n → n.choose k = a →
      1 ≤ k' → 2 * k' ≤ n' → n'.choose k' = a → n < n' → k' < k := by
    intro n k n' k' hk1 hk2 hk3 hk1' hk2' hk3' hnn
    by_contra hcon
    push_neg at hcon
    obtain ⟨j, hj⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    have h1 : n.choose k < n'.choose k := by
      rw [hj]; exact hstrict j n n' (by omega) hnn
    have h2 : n'.choose k ≤ n'.choose k' := hhalf n' k k' hcon (by omega)
    omega
  set S := {n : ℕ | ∃ (k : ℕ), (1 : ℕ) ≤ k ∧
      Real.exp (Real.log (↑n : ℝ) ^ (5 / 6 : ℝ)) ≤ (↑k : ℝ) ∧ (2 : ℕ) * k ≤ n ∧ n.choose k = a} with hS
  have hSfin : S.Finite := by
    refine (Set.finite_Iic a).subset ?_
    rintro n ⟨k, hk1, -, hk2, h⟩
    exact key n k hk1 hk2 h
  -- three interior rows are impossible
  have main : ∀ x y z : ℕ, x ∈ S → y ∈ S → z ∈ S → x < y → x < z → y ≠ z → False := by
    intro x y z hx hy hz hxy hxz hyz
    obtain ⟨kx, hx1, hx2, hx3, hx4⟩ := hx
    obtain ⟨ky, hy1, hy2, hy3, hy4⟩ := hy
    obtain ⟨kz, hz1, hz2, hz3, hz4⟩ := hz
    set T := {n' : ℕ | ∃ k' : ℕ, 1 ≤ k' ∧ k' < kx ∧ x < n' ∧ 2 * k' ≤ n' ∧ n'.choose k' = a ∧
        |(x : ℝ) - n'| + |(kx : ℝ) - k'| ≤
          Real.exp (Real.log (Real.log (a : ℝ)) ^ (9 / 10 : ℝ))} with hT
    have hyT : y ∈ T :=
      ⟨ky, hy1, hkk x kx y ky hx1 hx3 hx4 hy1 hy3 hy4 hxy, hxy, hy3, hy4,
        hD a ha₁ x kx y ky ⟨hx1, hx2, hx3, hx4⟩ ⟨hy1, hy2, hy3, hy4⟩⟩
    have hzT : z ∈ T :=
      ⟨kz, hz1, hkk x kx z kz hx1 hx3 hx4 hz1 hz3 hz4 hxz, hxz, hz3, hz4,
        hD a ha₁ x kx z kz ⟨hx1, hx2, hx3, hx4⟩ ⟨hz1, hz2, hz3, hz4⟩⟩
    have hTfin : T.Finite := by
      refine (Set.finite_Iic a).subset ?_
      rintro n' ⟨k', h1, -, -, h4, h5, -⟩
      exact key n' k' h1 h4 h5
    have h2 : 1 < T.ncard := (Set.one_lt_ncard_iff hTfin).2 ⟨y, z, hyT, hzT, hyz⟩
    have h1 : T.ncard ≤ 1 := hK a ha₂ x kx ⟨hx1, hx2, hx3, hx4⟩
    omega
  by_contra hc
  push_neg at hc
  obtain ⟨x, y, z, hx, hy, hz, hxy, hxz, hyz⟩ := (Set.two_lt_ncard_iff hSfin).1 hc
  rcases lt_or_gt_of_ne hxy with h1 | h1 <;> rcases lt_or_gt_of_ne hxz with h2 | h2 <;>
    rcases lt_or_gt_of_ne hyz with h3 | h3 <;>
    first
    | exact main x y z hx hy hz (by omega) (by omega) hyz
    | exact main y x z hy hx hz (by omega) (by omega) hxz
    | exact main z x y hz hx hy (by omega) (by omega) hxy
