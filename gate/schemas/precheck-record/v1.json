{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/precheck-record/v1.json",
  "title": "precheck-record/v1",
  "description": "nodes/<id>/attempts/precheck/<name>.json (D-34): the compact record a local precheck donates when the operator opts in. The same locating fields as an attestation, verdict precheck-fail, plus the terminal goal state — a verdict and a goal state, never a session (D-13's no-transcript rule). Only failures are recorded here: a passing precheck becomes a submission, and its attestation is the record. Deduplicated by the writer on (statement_hash, terminal goal state, first_failing_step); the gate validates the shape and nothing more, because an append claims nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "node",
    "statement_hash",
    "verdict",
    "first_failing_step",
    "diagnostic",
    "terminal_goal_state",
    "lean_toolchain",
    "mathlib_sha",
    "gate_spec_hash",
    "network_commit",
    "tooling",
    "date"
  ],
  "properties": {
    "schema": {
      "const": "precheck-record/v1"
    },
    "node": {
      "type": "string",
      "description": "node id, optionally target-qualified as <target>/<node>",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$"
    },
    "statement_hash": {
      "$ref": "#/$defs/sha256"
    },
    "verdict": {
      "const": "precheck-fail"
    },
    "first_failing_step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "diagnostic": {
      "type": "object",
      "description": "Structured, plain-string data; never rendered as markup",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "terminal_goal_state": {
      "description": "The serialized Lean goal where the attempt died; null when the run failed before elaboration",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "lean_toolchain": {
      "type": "string",
      "minLength": 1
    },
    "mathlib_sha": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha1"
        }
      ]
    },
    "gate_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "network_commit": {
      "$ref": "#/$defs/sha1"
    },
    "tooling": {
      "type": "object",
      "description": "Model and harness as declared by the operator (D-23); never verified",
      "additionalProperties": false,
      "required": [
        "model",
        "harness"
      ],
      "properties": {
        "model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "harness": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "date": {
      "type": "string",
      "description": "UTC, second precision, Z suffix",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
