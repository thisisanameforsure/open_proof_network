{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/graph/v2.json",
  "title": "graph/v2",
  "description": "targets/<id>/graph.json (D-25, D-35): every node of one target with its derived status, regenerated on every merge and never hand-edited. v2 (2026-09-10, F07-R8): status gains refuted and defective — what a merged counterexample and a merged vacuity certificate make of a node (D-12 #2, #3) — and each node gains cause, the machine-readable reason a derived status is what it is: dep-refuted for a node under a refuted one, witness-missing for a compiler-derived child whose witness slot is still a stub (D-29, F07-R6). v1 stays readable; a graph rendered by an older gate has neither value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_id",
    "root",
    "rendered_from",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "graph/v2"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "root": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "rendered_from": {
      "description": "the graph commit the products were rendered from; null for an uncommitted tree",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "status",
          "deps",
          "origin",
          "statement_hash",
          "relation",
          "tutorial",
          "trust_base",
          "proof_commit",
          "cause"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "status": {
            "enum": [
              "ready",
              "blocked",
              "proved",
              "refuted",
              "defective",
              "speculative",
              "superseded",
              "stale",
              "disputed",
              "abandoned"
            ]
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "origin": {
            "enum": [
              "authored",
              "compiler-derived",
              "variant",
              "skeleton-hole"
            ]
          },
          "statement_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relation": {
            "description": "D-30 label for a variant; null otherwise",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "resolves",
                  "partial",
                  "related"
                ]
              }
            ]
          },
          "tutorial": {
            "type": "boolean"
          },
          "trust_base": {
            "description": "compiler when the proving attestation says so (F02-R9); kernel for a proof the kernel checked; null when unproved",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "kernel",
                  "compiler"
                ]
              }
            ]
          },
          "proof_commit": {
            "description": "merge commit of the proof when proved",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            ]
          },
          "cause": {
            "description": "Why this status, where the reason is mechanical; null when it needs none",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            ]
          }
        }
      }
    }
  }
}
