{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/graph/v1.json",
  "title": "graph/v1",
  "description": "targets/<id>/graph.json (F03-R4; D-28 get_target): the target's DAG with every node's derived status. Regenerated by the post-merge job from nodes, attempts, attestations and status records; nodes sorted by node_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_id",
    "root",
    "rendered_from",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "graph/v1"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "root": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "rendered_from": {
      "description": "the graph commit the products were rendered from; null for an uncommitted tree",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "status",
          "deps",
          "origin",
          "statement_hash",
          "relation",
          "tutorial",
          "trust_base",
          "proof_commit"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "status": {
            "enum": [
              "ready",
              "blocked",
              "proved",
              "speculative",
              "superseded",
              "stale",
              "disputed",
              "abandoned"
            ]
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "origin": {
            "enum": [
              "authored",
              "compiler-derived",
              "variant",
              "skeleton-hole"
            ]
          },
          "statement_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relation": {
            "description": "D-30 label for a variant; null otherwise",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "resolves",
                  "partial",
                  "related"
                ]
              }
            ]
          },
          "tutorial": {
            "type": "boolean"
          },
          "trust_base": {
            "description": "compiler when the proving attestation says so (F02-R9); kernel for a proof the kernel checked; null when unproved",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "kernel",
                  "compiler"
                ]
              }
            ]
          },
          "proof_commit": {
            "description": "merge commit of the proof when proved",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            ]
          }
        }
      }
    }
  }
}
