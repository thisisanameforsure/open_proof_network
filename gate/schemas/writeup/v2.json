{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/writeup/v2.json",
  "title": "writeup/v2",
  "description": "targets/<id>/writeup/<n>.yaml (F24-R5; D-32 v3.34): one act in the life of a paper or a state-of-the-problem note. `record` starts a write-up (as writeup/v1 did) and names its authors; the others refer to it by `writeup`: `author-sign` (a listed author signs it), `arxiv`, `submitted`, `accepted`, `rejected` and `withdrawn`, each signed by a listed author. Anyone may make a `record`; it is `drafted` when it names the model that drafted it, `written` otherwise, and `steward-signed` once its signer or a signing author is a steward of the target or a listed curator. The network links what these name and does not verify a journal's decision. Append-only; versioned, never edited (D-34).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "action",
    "signer",
    "date",
    "via",
    "key",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "writeup/v2"
    },
    "target": {
      "$ref": "#/$defs/identifier"
    },
    "action": {
      "enum": [
        "record",
        "author-sign",
        "arxiv",
        "submitted",
        "accepted",
        "rejected",
        "withdrawn"
      ]
    },
    "writeup": {
      "description": "For every action but `record`: the number n of the write-up's `record`.",
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "paper",
        "note"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "url": {
      "$ref": "#/$defs/url"
    },
    "authors": {
      "description": "For a `record`: the logins of the write-up's authors, in order. It is released when every one of them has signed it (the signer of the record counts as signed).",
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/login"
      }
    },
    "arxiv": {
      "description": "For `arxiv`: the arXiv identifier, new style with optional version.",
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{4,5}(v[0-9]+)?$"
    },
    "journal": {
      "description": "For `submitted`, `accepted` and `rejected`: the journal's name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "doi": {
      "description": "For `accepted`, optional: the article's DOI.",
      "type": "string",
      "pattern": "^10\\.[0-9]{4,9}/\\S+$",
      "maxLength": 300
    },
    "model": {
      "description": "For a `record`, optional: the model that drafted the text (D-3 v3.31). A record naming one is `drafted` until a steward or curator signs it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "signer": {
      "description": "The login who signed this record.",
      "$ref": "#/$defs/login"
    },
    "date": {
      "description": "The day the record was made (UTC). The gate refuses a record dated more than one day from its own clock, so a date cannot be written into an old window.",
      "$ref": "#/$defs/day"
    },
    "via": {
      "description": "How the signature was made (D-3, D-32 v3.33): `ssh`, by the signer's own SSH key; `approval-key`, by the network's approval key through the service, for a login signed in with GitHub on the site, in which case `key` must equal the graph's keys/approval.pub in the merge's parent tree.",
      "enum": [
        "ssh",
        "approval-key"
      ]
    },
    "key": {
      "description": "The SSH public key the signature verifies under: the steward's own (`via: ssh`) or the network's approval key (`via: approval-key`).",
      "$ref": "#/$defs/public_key"
    },
    "signature": {
      "description": "An OpenSSH SSHSIG armored signature over the record's canonical body, made with the private half of `key`.",
      "$ref": "#/$defs/sshsig"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 500
    },
    "public_key": {
      "type": "string",
      "pattern": "^ssh-ed25519 [A-Za-z0-9+/=]+( [^\\n]*)?$",
      "maxLength": 1000
    },
    "sshsig": {
      "type": "string",
      "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?$",
      "maxLength": 4000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "record"
          }
        }
      },
      "then": {
        "required": [
          "kind",
          "title",
          "url",
          "authors"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "writeup"
              ]
            },
            {
              "required": [
                "arxiv"
              ]
            },
            {
              "required": [
                "journal"
              ]
            },
            {
              "required": [
                "doi"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "writeup"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "kind"
              ]
            },
            {
              "required": [
                "title"
              ]
            },
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "authors"
              ]
            },
            {
              "required": [
                "model"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "arxiv"
          }
        }
      },
      "then": {
        "required": [
          "arxiv"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "submitted",
              "accepted",
              "rejected"
            ]
          }
        }
      },
      "then": {
        "required": [
          "journal"
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "action": {
              "const": "accepted"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "doi"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "action": {
              "const": "arxiv"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "arxiv"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "action": {
              "enum": [
                "submitted",
                "accepted",
                "rejected"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "journal"
          ]
        }
      }
    }
  ]
}
