{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/writeup/v1.json",
  "title": "writeup/v1",
  "description": "targets/<id>/writeup/<n>.yaml (F15-R6; D-32): the record that a paper or a state-of-the-problem note about the target exists, signed by an active steward or a listed curator with their own SSH key (SSHSIG, opn_gate.signed) over the canonical body, the document without `signature`. A `paper` record makes a resolved target `written-up` (D-33 v3.17). The note's text stays at targets/<id>/note.md. Append-only; versioned, never edited (D-34).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "kind",
    "title",
    "url",
    "date",
    "signer",
    "key",
    "signature"
  ],
  "properties": {
    "schema": { "const": "writeup/v1" },
    "target": { "$ref": "#/$defs/identifier" },
    "kind": { "enum": ["paper", "note"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "url": { "$ref": "#/$defs/url" },
    "date": { "$ref": "#/$defs/day" },
    "signer": { "$ref": "#/$defs/login" },
    "key": { "$ref": "#/$defs/public_key" },
    "signature": { "$ref": "#/$defs/sshsig" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "login": { "type": "string", "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$" },
    "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "url": { "type": "string", "pattern": "^https://", "maxLength": 500 },
    "public_key": { "type": "string", "pattern": "^ssh-ed25519 [A-Za-z0-9+/=]+( [^\\n]*)?$", "maxLength": 1000 },
    "sshsig": {
      "type": "string",
      "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?$",
      "maxLength": 4000
    }
  }
}
