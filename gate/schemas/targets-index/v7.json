{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/targets-index/v7.json",
  "title": "targets-index/v7",
  "description": "targets/index.json (D-25, D-35): one row per target, regenerated on every merge. v6 (2026-09-16, F15-R9; D-6, D-32, D-33 v3.17): the document carries the graph's policy state once at the top (whether the steward rule is enforced, since when, on what evidence); each row carries the target's active stewards (login, name, link, since), its digestion state with the counts behind it (null unless resolved: undigested, explained or written-up), and whether it is a calibration target; `not_claimable` may name `no-steward`. v5 could not be edited (D-34). targets/index.json (D-25, D-35): one row per target, regenerated on every merge. v5 (2026-09-14, F14-R1, R9): a curated target is claimable while listed, active or dormant, whatever its grade or posting — `not_claimable` names a closed status or an upstream-drift freeze only; each row carries the target's recorded statement evidence (the catalog score behind step 9), what a proof on the root needs now (`step9`), and each second formalization with its equivalence state. v4 could not be edited (D-34). targets/index.json (D-25, D-35): one row per target, regenerated on every merge. v4 (2026-09-12, F12-R14): each subject row carries the statement-QA pass state per check (D-9 v3.12: what was checked, and whether the pass is complete and fresh for the statement as it stands), each target carries the documented attempts that count toward D-9's M and the ones recorded against an earlier hash, and the drift flag with its date (D-10 v3.12). v3 could not be edited (D-34). targets/index.json (D-25, D-35): one row per target, regenerated on every merge. v3 (2026-09-11, F11-R12/R3/R4, Q9): D-9 v3.12's second rung is screened-and-signed; each row carries the target's track, the per-subject fidelity certificates as a signature count and the named signers (D-9 v3.12: signatures are counted and named), the D-10 posting, and — when the target is not claimable — the reasons, so a reader learns why without deriving it. v2 could not be edited (D-34), and its number was already spent on F07-R8's node counts. v7 (2026-09-20, D-4 v3.20): `step9` says what a proof that settles the root needs, and gains `calibration` (nothing: the target is a known result); nothing beneath the root asks a review on any target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rendered_from",
    "policy",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "targets-index/v7"
    },
    "rendered_from": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "policy": {
      "description": "F15-R3, R9: the graph's policy.json as it stands, or the defaults when the file is absent (not enforced).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steward_rule"
      ],
      "properties": {
        "steward_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforced",
            "since",
            "evidence"
          ],
          "properties": {
            "enforced": {
              "type": "boolean"
            },
            "since": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              ]
            },
            "evidence": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              ]
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "root",
          "root_statement_hash",
          "fidelity",
          "status",
          "mathlib_sha",
          "node_counts",
          "claimable",
          "track",
          "subjects",
          "posting",
          "not_claimable",
          "attempts",
          "drift",
          "statement_evidence",
          "step9",
          "formalizations",
          "stewards",
          "digestion",
          "calibration"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "root": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "root_statement_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fidelity": {
            "enum": [
              "mechanical-only",
              "screened-and-signed",
              "author-attested",
              "expert-attested",
              "published-and-uncontested"
            ]
          },
          "status": {
            "enum": [
              "listed",
              "active",
              "resolved",
              "dormant",
              "known-result"
            ]
          },
          "mathlib_sha": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            ]
          },
          "node_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ready",
              "blocked",
              "proved",
              "refuted",
              "defective",
              "speculative",
              "superseded",
              "stale",
              "disputed",
              "abandoned"
            ],
            "properties": {
              "ready": {
                "type": "integer",
                "minimum": 0
              },
              "blocked": {
                "type": "integer",
                "minimum": 0
              },
              "proved": {
                "type": "integer",
                "minimum": 0
              },
              "speculative": {
                "type": "integer",
                "minimum": 0
              },
              "superseded": {
                "type": "integer",
                "minimum": 0
              },
              "stale": {
                "type": "integer",
                "minimum": 0
              },
              "disputed": {
                "type": "integer",
                "minimum": 0
              },
              "abandoned": {
                "type": "integer",
                "minimum": 0
              },
              "refuted": {
                "type": "integer",
                "minimum": 0
              },
              "defective": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "claimable": {
            "description": "F14-R1: true unless the status is closed (resolved, known-result) or an upstream edit freezes the root; the grade and the posting are published beside it and do not decide it.",
            "type": "boolean"
          },
          "track": {
            "description": "D-6's two tracks; null for a target with no target.yaml (a pre-F11 graph).",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "open",
                  "formalization"
                ]
              }
            ]
          },
          "subjects": {
            "description": "One row per fidelity subject (the root and each definition), latest certificate first in time order (F11-R3). Empty for a target with no certificates.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject",
                "grade",
                "signature_count",
                "signers",
                "qa"
              ],
              "properties": {
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "grade": {
                  "enum": [
                    "mechanical-only",
                    "screened-and-signed",
                    "author-attested",
                    "expert-attested",
                    "published-and-uncontested"
                  ]
                },
                "signature_count": {
                  "description": "Distinct attestors who signed this subject at screened-and-signed or above. A mechanical-only certificate is the machine's own and signs for nobody.",
                  "type": "integer",
                  "minimum": 0
                },
                "signers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "uniqueItems": true
                },
                "qa": {
                  "description": "F12-R14: the pass state for the subject as it stands — the latest fresh verdict per check, or null where a check has not run.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "complete",
                    "stale",
                    "checks",
                    "unrouted_findings",
                    "fresh_records"
                  ],
                  "properties": {
                    "complete": {
                      "type": "boolean"
                    },
                    "stale": {
                      "type": "boolean"
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "compile",
                        "screen-statement",
                        "screen-negation",
                        "screen-false",
                        "screen-consequence",
                        "brief",
                        "backtranslation",
                        "equivalence"
                      ],
                      "properties": {
                        "compile": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "screen-statement": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "screen-negation": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "screen-false": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "screen-consequence": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "brief": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "backtranslation": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "equivalence": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        }
                      }
                    },
                    "unrouted_findings": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "fresh_records": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "posting": {
            "description": "The D-10 posting from target.yaml, or null.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "venue",
                  "url",
                  "date"
                ],
                "properties": {
                  "venue": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              }
            ]
          },
          "not_claimable": {
            "description": "Why claimable is false, as machine-readable reasons (F14-R1: `status-<status>` or `upstream-drift`; F15-R4: `no-steward`, an open-track target with no active steward while the rule is enforced). Empty when the target is claimable.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "maxLength": 80
            },
            "uniqueItems": true
          },
          "attempts": {
            "description": "F12-R10, R14: documented external attempts — `counted` against the root's current hash (D-9's M), `recorded` in all.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "counted",
              "recorded"
            ],
            "properties": {
              "counted": {
                "type": "integer",
                "minimum": 0
              },
              "recorded": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "drift": {
            "description": "F12-R11, R12, R14: the drift flag that stands on the root as it is, or null — an upstream edit (compute frozen) or a resolved-elsewhere notice, with its date and record.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "date",
                  "record",
                  "frozen"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "upstream-edit",
                      "resolved-elsewhere"
                    ]
                  },
                  "date": {
                    "type": "string"
                  },
                  "record": {
                    "type": "string"
                  },
                  "frozen": {
                    "type": "boolean"
                  },
                  "upstream": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object"
                      }
                    ]
                  },
                  "citation": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "statement_evidence": {
            "description": "F14-R3, R9: the newest statement-evidence record for the root, or null. `current` is whether it is pinned to the root's statement hash as it stands; only a current record counts for step 9.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "key",
                  "score",
                  "letter",
                  "catalog_commit",
                  "statement_hash",
                  "current",
                  "misformalization_open"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^evidence/root-[1-9][0-9]*\\.ya?ml$"
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "score": {
                    "type": "integer"
                  },
                  "letter": {
                    "enum": [
                      "A",
                      "B+",
                      "B",
                      "C",
                      "D"
                    ]
                  },
                  "catalog_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "statement_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "current": {
                    "type": "boolean"
                  },
                  "misformalization_open": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "step9": {
            "description": "F14-R5, R9; D-4 v3.20: what a proof that settles the root needs at merge — `certificate` (a counting fidelity certificate at screened-and-signed or above), `evidence` (recorded registry evidence at the configured minimum), `review` (a non-author's approving review, D-4 step 9), or `calibration` (nothing: a known result). Nothing beneath the root asks a review.",
            "enum": [
              "certificate",
              "evidence",
              "review",
              "calibration"
            ]
          },
          "formalizations": {
            "description": "F14-R7, R8: second formalizations of the target's conjecture, outside nodes/, with the latest equivalence verdict against the root and its exhibit, or null where none has run.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "statement_hash",
                "equivalence",
                "exhibit"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "maxLength": 100
                },
                "statement_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "equivalence": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "pass",
                        "fail",
                        "inconclusive"
                      ]
                    }
                  ]
                },
                "exhibit": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  ]
                }
              }
            }
          },
          "stewards": {
            "description": "F15-R1, R9: the target's active stewards — the logins whose latest valid steward record is a commit — in the order they committed.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "login",
                "name",
                "link",
                "since"
              ],
              "properties": {
                "login": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "link": {
                  "type": "string",
                  "pattern": "^https://",
                  "maxLength": 500
                },
                "since": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              }
            }
          },
          "digestion": {
            "description": "F15-R7 (D-33 v3.17): the digestion state of a resolved target — written-up when a paper record exists, explained when every proved node in the closing artifact's dependency closure carries a valid signed explainer, else undigested — and null for a target in any other status; with the closure's size and how many of its nodes are explained, and the target's proved nodes and how many of those carry a signed explainer, for the home page's coverage count.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "closure",
              "closure_explained",
              "proved",
              "proved_explained"
            ],
            "properties": {
              "state": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "enum": [
                      "undigested",
                      "explained",
                      "written-up"
                    ]
                  }
                ]
              },
              "closure": {
                "type": "integer",
                "minimum": 0
              },
              "closure_explained": {
                "type": "integer",
                "minimum": 0
              },
              "proved": {
                "type": "integer",
                "minimum": 0
              },
              "proved_explained": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "calibration": {
            "description": "F15-R13, Q9 (Stages v3.17): a known result the calibration run exercises; labelled on the site and excluded from every count of open-problem work.",
            "type": "boolean"
          }
        }
      }
    }
  }
}
