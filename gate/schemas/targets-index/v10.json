{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/targets-index/v10.json",
  "title": "targets-index/v10",
  "description": "v10 (2026-10-10, F25-R7; D-10 v3.37): each row carries `registrations`, the target's registrations in public registries (Palomar) derived from its registration records. v9 could not be edited (D-34). targets/index.json (D-25, D-35): one row per target, regenerated on every merge. v8 (2026-10-07, F23-R14; D-32 v3.33): each active steward also carries `admitted_by` (`self`, the admitting curator's login, or null for a steward/v1 record, which predates the field and was merged by a curator under the old rule) and `via` (`ssh` or `approval-key`), and `link` may be null (a steward made through the site while admission is open). v7 could not be edited (D-34). targets/index.json (D-25, D-35): one row per target, regenerated on every merge. v6 (2026-09-16, F15-R9; D-6, D-32, D-33 v3.17): the document carries the graph's policy state once at the top (whether the steward rule is enforced, since when, on what evidence); each row carries the target's active stewards (login, name, link, since), its digestion state with the counts behind it (null unless resolved: undigested, explained or written-up), and whether it is a calibration target; `not_claimable` may name `no-steward`. v5 could not be edited (D-34). targets/index.json (D-25, D-35): one row per target, regenerated on every merge. v5 (2026-09-14, F14-R1, R9): a curated target is claimable while listed, active or dormant, whatever its grade or posting — `not_claimable` names a closed status or an upstream-drift freeze only; each row carries the target's recorded statement evidence (the catalog score behind step 9), what a proof on the root needs now (`step9`), and each second formalization with its equivalence state. v4 could not be edited (D-34). targets/index.json (D-25, D-35): one row per target, regenerated on every merge. v4 (2026-09-12, F12-R14): each subject row carries the statement-QA pass state per check (D-9 v3.12: what was checked, and whether the pass is complete and fresh for the statement as it stands), each target carries the documented attempts that count toward D-9's M and the ones recorded against an earlier hash, and the drift flag with its date (D-10 v3.12). v3 could not be edited (D-34). targets/index.json (D-25, D-35): one row per target, regenerated on every merge. v3 (2026-09-11, F11-R12/R3/R4, Q9): D-9 v3.12's second rung is screened-and-signed; each row carries the target's track, the per-subject fidelity certificates as a signature count and the named signers (D-9 v3.12: signatures are counted and named), the D-10 posting, and — when the target is not claimable — the reasons, so a reader learns why without deriving it. v2 could not be edited (D-34), and its number was already spent on F07-R8's node counts. v7 (2026-09-20, D-4 v3.20): `step9` says what a proof that settles the root needs, and gains `calibration` (nothing: the target is a known result); nothing beneath the root asks a review on any target. v9 (F24-R6, R7; D-32 v3.34): the policy's panel settings, each steward's lapse, each target's panel motions and its write-ups with the one shown as official.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rendered_from",
    "policy",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "targets-index/v10"
    },
    "rendered_from": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "policy": {
      "description": "F15-R3, R9: the graph's policy.json as it stands, or the defaults when the file is absent (not enforced).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steward_rule",
        "panel"
      ],
      "properties": {
        "steward_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforced",
            "since",
            "evidence"
          ],
          "properties": {
            "enforced": {
              "type": "boolean"
            },
            "since": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              ]
            },
            "evidence": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              ]
            }
          }
        },
        "panel": {
          "description": "The panel settings in force (policy.json, or the defaults when it carries none), each with since and reason (null for a default).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vote_threshold",
            "vote_window_days",
            "vote_minimum",
            "vote_minimum_from",
            "steward_cap",
            "steward_lapse_days"
          ],
          "properties": {
            "vote_threshold": {
              "description": "The share of counted votes a motion needs. It passes when yes votes are at least numerator/denominator of the counted votes AND more than the no votes, so a tie never passes. 1/2 is a simple majority; 2/3 a two-thirds majority. Default 1/2.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "since",
                "reason"
              ],
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "numerator",
                    "denominator"
                  ],
                  "properties": {
                    "numerator": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "denominator": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    }
                  }
                },
                "since": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    }
                  ]
                },
                "reason": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  ]
                }
              }
            },
            "vote_window_days": {
              "description": "How many days a motion stays open for votes after the day it was opened. Only votes cast inside the window count; a steward who does not vote counts neither way. Default 14.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "since",
                "reason"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                "since": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    }
                  ]
                },
                "reason": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  ]
                }
              }
            },
            "vote_minimum": {
              "description": "The fewest counted votes a motion needs to pass once the panel has at least vote_minimum_from members, so one voice cannot speak for a large silent panel. Default 2.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "since",
                "reason"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                "since": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    }
                  ]
                },
                "reason": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  ]
                }
              }
            },
            "vote_minimum_from": {
              "description": "The panel size from which vote_minimum applies. Below it, one counted vote can pass a motion. Default 3.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "since",
                "reason"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                "since": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    }
                  ]
                },
                "reason": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  ]
                }
              }
            },
            "steward_cap": {
              "description": "The most problems one person may steward at once, counted across the graph without lapsed stewardships, so no one can take every problem. Default 5.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "since",
                "reason"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "since": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    }
                  ]
                },
                "reason": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  ]
                }
              }
            },
            "steward_lapse_days": {
              "description": "Days without a signed act on a problem (a steward record, a motion, a vote, a write-up record, a words signature) after which a steward lapses from its panel. Nothing is rewritten; they rejoin by the usual route. Default 183, about six months.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "since",
                "reason"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3650
                },
                "since": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    }
                  ]
                },
                "reason": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "root",
          "root_statement_hash",
          "fidelity",
          "status",
          "mathlib_sha",
          "node_counts",
          "claimable",
          "track",
          "subjects",
          "posting",
          "not_claimable",
          "attempts",
          "drift",
          "statement_evidence",
          "step9",
          "formalizations",
          "stewards",
          "digestion",
          "calibration",
          "panel",
          "writeups",
          "registrations"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "root": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "root_statement_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fidelity": {
            "enum": [
              "mechanical-only",
              "screened-and-signed",
              "author-attested",
              "expert-attested",
              "published-and-uncontested"
            ]
          },
          "status": {
            "enum": [
              "listed",
              "active",
              "resolved",
              "dormant",
              "known-result"
            ]
          },
          "mathlib_sha": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            ]
          },
          "node_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ready",
              "blocked",
              "proved",
              "refuted",
              "defective",
              "speculative",
              "superseded",
              "stale",
              "disputed",
              "abandoned"
            ],
            "properties": {
              "ready": {
                "type": "integer",
                "minimum": 0
              },
              "blocked": {
                "type": "integer",
                "minimum": 0
              },
              "proved": {
                "type": "integer",
                "minimum": 0
              },
              "speculative": {
                "type": "integer",
                "minimum": 0
              },
              "superseded": {
                "type": "integer",
                "minimum": 0
              },
              "stale": {
                "type": "integer",
                "minimum": 0
              },
              "disputed": {
                "type": "integer",
                "minimum": 0
              },
              "abandoned": {
                "type": "integer",
                "minimum": 0
              },
              "refuted": {
                "type": "integer",
                "minimum": 0
              },
              "defective": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "claimable": {
            "description": "F14-R1: true unless the status is closed (resolved, known-result) or an upstream edit freezes the root; the grade and the posting are published beside it and do not decide it.",
            "type": "boolean"
          },
          "track": {
            "description": "D-6's two tracks; null for a target with no target.yaml (a pre-F11 graph).",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "open",
                  "formalization"
                ]
              }
            ]
          },
          "subjects": {
            "description": "One row per fidelity subject (the root and each definition), latest certificate first in time order (F11-R3). Empty for a target with no certificates.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject",
                "grade",
                "signature_count",
                "signers",
                "qa"
              ],
              "properties": {
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "grade": {
                  "enum": [
                    "mechanical-only",
                    "screened-and-signed",
                    "author-attested",
                    "expert-attested",
                    "published-and-uncontested"
                  ]
                },
                "signature_count": {
                  "description": "Distinct attestors who signed this subject at screened-and-signed or above. A mechanical-only certificate is the machine's own and signs for nobody.",
                  "type": "integer",
                  "minimum": 0
                },
                "signers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "uniqueItems": true
                },
                "qa": {
                  "description": "F12-R14: the pass state for the subject as it stands — the latest fresh verdict per check, or null where a check has not run.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "complete",
                    "stale",
                    "checks",
                    "unrouted_findings",
                    "fresh_records"
                  ],
                  "properties": {
                    "complete": {
                      "type": "boolean"
                    },
                    "stale": {
                      "type": "boolean"
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "compile",
                        "screen-statement",
                        "screen-negation",
                        "screen-false",
                        "screen-consequence",
                        "brief",
                        "backtranslation",
                        "equivalence"
                      ],
                      "properties": {
                        "compile": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "screen-statement": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "screen-negation": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "screen-false": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "screen-consequence": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "brief": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "backtranslation": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        },
                        "equivalence": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "pass",
                                "fail",
                                "inconclusive"
                              ]
                            }
                          ]
                        }
                      }
                    },
                    "unrouted_findings": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "fresh_records": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "posting": {
            "description": "The D-10 posting from target.yaml, or null.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "venue",
                  "url",
                  "date"
                ],
                "properties": {
                  "venue": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              }
            ]
          },
          "not_claimable": {
            "description": "Why claimable is false, as machine-readable reasons (F14-R1: `status-<status>` or `upstream-drift`; F15-R4: `no-steward`, an open-track target with no active steward while the rule is enforced). Empty when the target is claimable.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "maxLength": 80
            },
            "uniqueItems": true
          },
          "attempts": {
            "description": "F12-R10, R14: documented external attempts — `counted` against the root's current hash (D-9's M), `recorded` in all.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "counted",
              "recorded"
            ],
            "properties": {
              "counted": {
                "type": "integer",
                "minimum": 0
              },
              "recorded": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "drift": {
            "description": "F12-R11, R12, R14: the drift flag that stands on the root as it is, or null — an upstream edit (compute frozen) or a resolved-elsewhere notice, with its date and record.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "date",
                  "record",
                  "frozen"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "upstream-edit",
                      "resolved-elsewhere"
                    ]
                  },
                  "date": {
                    "type": "string"
                  },
                  "record": {
                    "type": "string"
                  },
                  "frozen": {
                    "type": "boolean"
                  },
                  "upstream": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object"
                      }
                    ]
                  },
                  "citation": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "statement_evidence": {
            "description": "F14-R3, R9: the newest statement-evidence record for the root, or null. `current` is whether it is pinned to the root's statement hash as it stands; only a current record counts for step 9.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "key",
                  "score",
                  "letter",
                  "catalog_commit",
                  "statement_hash",
                  "current",
                  "misformalization_open"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^evidence/root-[1-9][0-9]*\\.ya?ml$"
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "score": {
                    "type": "integer"
                  },
                  "letter": {
                    "enum": [
                      "A",
                      "B+",
                      "B",
                      "C",
                      "D"
                    ]
                  },
                  "catalog_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "statement_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "current": {
                    "type": "boolean"
                  },
                  "misformalization_open": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "step9": {
            "description": "F14-R5, R9; D-4 v3.20: what a proof that settles the root needs at merge — `certificate` (a counting fidelity certificate at screened-and-signed or above), `evidence` (recorded registry evidence at the configured minimum), `review` (a non-author's approving review, D-4 step 9), or `calibration` (nothing: a known result). Nothing beneath the root asks a review.",
            "enum": [
              "certificate",
              "evidence",
              "review",
              "calibration"
            ]
          },
          "formalizations": {
            "description": "F14-R7, R8: second formalizations of the target's conjecture, outside nodes/, with the latest equivalence verdict against the root and its exhibit, or null where none has run.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "statement_hash",
                "equivalence",
                "exhibit"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "maxLength": 100
                },
                "statement_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "equivalence": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "pass",
                        "fail",
                        "inconclusive"
                      ]
                    }
                  ]
                },
                "exhibit": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  ]
                }
              }
            }
          },
          "stewards": {
            "description": "F15-R1, F24-R4: the target's stewards whose latest valid record is a commit, lapsed or not, in the order they committed. A lapsed steward is not on the panel and is not counted for claimability.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "login",
                "name",
                "link",
                "since",
                "admitted_by",
                "via",
                "last_act",
                "lapsed"
              ],
              "properties": {
                "login": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "link": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^https://",
                      "maxLength": 500
                    }
                  ]
                },
                "since": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "admitted_by": {
                  "description": "D-32 v3.33: `self` under open admission; the curator who merged it under reviewed; null for a steward/v1 record.",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "const": "self"
                    },
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                    },
                    {
                      "type": "string",
                      "pattern": "^motion:[1-9][0-9]*$"
                    }
                  ]
                },
                "via": {
                  "description": "How the commitment was signed (D-3, D-32 v3.33).",
                  "enum": [
                    "ssh",
                    "approval-key"
                  ]
                },
                "last_act": {
                  "description": "The day of the steward's latest signed act on the target.",
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "lapsed": {
                  "description": "Whether last_act is more than steward_lapse_days before the rendered commit's day.",
                  "type": "boolean"
                }
              }
            }
          },
          "digestion": {
            "description": "F15-R7 (D-33 v3.17): the digestion state of a resolved target — written-up when a paper record exists, explained when every proved node in the closing artifact's dependency closure carries a valid signed explainer, else undigested — and null for a target in any other status; with the closure's size and how many of its nodes are explained, and the target's proved nodes and how many of those carry a signed explainer, for the home page's coverage count.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "closure",
              "closure_explained",
              "proved",
              "proved_explained"
            ],
            "properties": {
              "state": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "enum": [
                      "undigested",
                      "explained",
                      "written-up"
                    ]
                  }
                ]
              },
              "closure": {
                "type": "integer",
                "minimum": 0
              },
              "closure_explained": {
                "type": "integer",
                "minimum": 0
              },
              "proved": {
                "type": "integer",
                "minimum": 0
              },
              "proved_explained": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "calibration": {
            "description": "F15-R13, Q9 (Stages v3.17): a known result the calibration run exercises; labelled on the site and excluded from every count of open-problem work.",
            "type": "boolean"
          },
          "panel": {
            "description": "F24-R2, R3: the target's panel (its stewards who have not lapsed) and every motion put to it.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "members",
              "motions"
            ],
            "properties": {
              "members": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                }
              },
              "motions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "n",
                    "kind",
                    "subject",
                    "opened_by",
                    "opened",
                    "closes",
                    "state",
                    "yes",
                    "no",
                    "uncounted"
                  ],
                  "properties": {
                    "n": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "kind": {
                      "enum": [
                        "invite",
                        "verify-writeup",
                        "authorship-threshold"
                      ]
                    },
                    "subject": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "maxProperties": 2,
                      "properties": {
                        "login": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                        },
                        "note": {
                          "description": "For an invitation: the part of the work the invitee is asked for, in a sentence (an area of the proof). Free text, escaped where shown.",
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "writeup": {
                          "description": "The write-up's number n in targets/<id>/writeup/<n>.yaml.",
                          "type": "integer",
                          "minimum": 1
                        },
                        "threshold": {
                          "description": "The ledger threshold (D-32): entries above it are coauthors.",
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    },
                    "opened_by": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                    },
                    "opened": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "closes": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "state": {
                      "description": "`open` until its window closes; then `passed` or `failed`. An invitation by a curator, or any motion by the only counted member, is `passed` at once.",
                      "enum": [
                        "open",
                        "passed",
                        "failed"
                      ]
                    },
                    "yes": {
                      "description": "Counted yes votes (latest per member, inside the window).",
                      "type": "integer",
                      "minimum": 0
                    },
                    "no": {
                      "description": "Counted no votes.",
                      "type": "integer",
                      "minimum": 0
                    },
                    "uncounted": {
                      "description": "Members who voted but whose vote is not counted: provers on verify-writeup and authorship-threshold.",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                      }
                    }
                  }
                }
              }
            }
          },
          "writeups": {
            "description": "F24-R5, R7: every write-up of the target, and `official`, the number of the one at the highest stage (newest within a stage; a withdrawn one never), or null.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "official",
              "items"
            ],
            "properties": {
              "official": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "n",
                    "kind",
                    "title",
                    "url",
                    "stage",
                    "model",
                    "authors",
                    "signed",
                    "coauthors",
                    "arxiv",
                    "journal",
                    "doi"
                  ],
                  "properties": {
                    "n": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "kind": {
                      "enum": [
                        "paper",
                        "note"
                      ]
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://",
                      "maxLength": 500
                    },
                    "stage": {
                      "description": "The write-up's stage, derived from its records (D-32 v3.34): the ladder climbed in order, each rung needing the one below it: drafted or written (the record names a model or not), steward-signed (its signer or a signing author is a steward or curator), panel-verified (a verify-writeup motion on it passed), released (every listed author signed), then on-arxiv, submitted or accepted, the highest whose record exists; a rejection after the latest submission returns it to on-arxiv (or released without one); a withdrawal is final.",
                      "enum": [
                        "drafted",
                        "written",
                        "steward-signed",
                        "panel-verified",
                        "released",
                        "on-arxiv",
                        "submitted",
                        "accepted",
                        "withdrawn"
                      ]
                    },
                    "model": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "authors": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                      }
                    },
                    "signed": {
                      "description": "The listed authors who have signed it.",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                      }
                    },
                    "coauthors": {
                      "description": "Stewards who signed the verified write-up or a section of the target's words (D-32 v3.34).",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9]){0,38}$"
                      }
                    },
                    "arxiv": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "journal": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "doi": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "registrations": {
            "type": "array",
            "description": "F25-R7 (D-10 v3.37): the target's registrations in public registries, derived from its registration records — the latest per registry id, withdrawn ones set aside; empty for most targets.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "registry",
                "registry_id",
                "version",
                "status",
                "url"
              ],
              "properties": {
                "registry": {
                  "enum": [
                    "palomar"
                  ]
                },
                "registry_id": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^PALOMAR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}$"
                    }
                  ]
                },
                "version": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ]
                },
                "status": {
                  "enum": [
                    "submitted",
                    "registered",
                    "revision_required",
                    "rejected"
                  ]
                },
                "url": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^https://",
                      "maxLength": 500
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
