{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/meta/v4.json",
  "title": "meta/v4",
  "description": "v3 (2026-09-10, D-3 v3.12): origin gains skeleton-hole. v2 (2026-09-09, F02-R6): optional acknowledged_hazards. v1: the D-3 fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "status",
    "deps",
    "statement-hash",
    "origin",
    "provenance",
    "tutorial"
  ],
  "properties": {
    "schema": {
      "const": "meta/v4"
    },
    "id": {
      "$ref": "#/$defs/node_id"
    },
    "status": {
      "type": "string",
      "description": "Derived node status (F03 model); bot-owned",
      "pattern": "^[a-z][a-z-]*$"
    },
    "deps": {
      "type": "array",
      "description": "Node ids this node's Context.lean declares (D-4 step 8)",
      "items": {
        "$ref": "#/$defs/node_id"
      },
      "uniqueItems": true
    },
    "statement-hash": {
      "description": "sha256 of Statement.lean bytes (D-3, D-4 step 2)",
      "$ref": "#/$defs/sha256"
    },
    "origin": {
      "enum": [
        "authored",
        "compiler-derived",
        "variant",
        "skeleton-hole"
      ]
    },
    "provenance": {
      "type": "object",
      "description": "Who authored the statement and with what (D-23)",
      "additionalProperties": false,
      "required": [
        "author"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "tutorial": {
      "type": "boolean",
      "description": "Off-ledger, permanently open (D-27)"
    },
    "acknowledged_hazards": {
      "type": "array",
      "description": "Step 6 findings the author intends (F02-R4): matched on checker and location; the justification is contributor free text served as untrusted data (D-28)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checker",
          "location",
          "justification"
        ],
        "properties": {
          "checker": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "uniqueItems": true
    },
    "supersedes": {
      "$ref": "#/$defs/node_id",
      "description": "the node this revision supersedes (D-8, F08-R9)"
    }
  },
  "$defs": {
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
