{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/meta/v1.json",
  "title": "meta/v1",
  "description": "nodes/<id>/META.yaml (D-3). Submission-immutable; the status field is bot-owned (F03). Versioned, never edited (D-34).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "status", "deps", "statement-hash", "origin", "provenance", "tutorial"],
  "properties": {
    "schema": { "const": "meta/v1" },
    "id": { "$ref": "#/$defs/node_id" },
    "status": {
      "type": "string",
      "description": "Derived node status (F03 model); bot-owned",
      "pattern": "^[a-z][a-z-]*$"
    },
    "deps": {
      "type": "array",
      "description": "Node ids this node's Context.lean declares (D-4 step 8)",
      "items": { "$ref": "#/$defs/node_id" },
      "uniqueItems": true
    },
    "statement-hash": {
      "description": "sha256 of Statement.lean bytes (D-3, D-4 step 2)",
      "$ref": "#/$defs/sha256"
    },
    "origin": { "enum": ["authored", "compiler-derived", "variant"] },
    "provenance": {
      "type": "object",
      "description": "Who authored the statement and with what (D-23)",
      "additionalProperties": false,
      "required": ["author"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "model": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "source": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "tutorial": { "type": "boolean", "description": "Off-ledger, permanently open (D-27)" }
  },
  "$defs": {
    "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
