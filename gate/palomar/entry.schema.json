{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/palomar/entry.schema.json",
  "title": "palomar-entry (observed)",
  "description": "The shape of data.palomar-registry.org/entries/<id>-v<n>.json as observed on 2026-10-10 across seven registered entries (F25-T6). Palomar publishes no schema for it; this one is the network's reading, kept loose (additional properties allowed) and holding only the fields the network reads: the id and version, the formalization's paths and pins, the source's repository, commit and licence, the verification's hashes, the trust block and the status. There is no `mathlib_revision` field (an earlier reading of the records invented one): the pinned libraries are `project_dependencies`, each `{name, repository, revision}`, and the Mathlib commit is the entry named `mathlib`. `kernels` is a list of {name, argv} objects and is absent on the oldest entry; `project_path` sits under `source`.",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "formalization",
    "source",
    "verification",
    "trust",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PALOMAR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "abstract": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "properties": {
        "arxiv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "msc2020": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "formalization": {
      "type": "object",
      "required": [
        "theorem_names",
        "challenge_path",
        "solution_path",
        "comparator_config_path",
        "formalization_metadata_path",
        "lakefile_path",
        "lean_toolchain",
        "permitted_axioms",
        "project_dependencies"
      ],
      "properties": {
        "theorem_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definition_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "challenge_path": {
          "type": "string"
        },
        "solution_path": {
          "type": "string"
        },
        "comparator_config_path": {
          "type": "string"
        },
        "formalization_metadata_path": {
          "type": "string"
        },
        "lakefile_path": {
          "type": "string"
        },
        "lean_toolchain": {
          "type": "string",
          "pattern": "^leanprover/lean4:v"
        },
        "permitted_axioms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "repository",
              "revision"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "repository": {
                "type": "string"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "license"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "repository_url": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "license": {
          "type": "object",
          "required": [
            "declared_identifier",
            "path",
            "sha256"
          ],
          "properties": {
            "declared_identifier": {
              "type": "string"
            },
            "detected_identifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "project_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "challenge_sha256",
        "solution_sha256"
      ],
      "properties": {
        "challenge_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "solution_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kernels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "absent on entries verified before 2026-09-25"
        },
        "run_id": {
          "type": "integer"
        },
        "workflow_url": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string"
        },
        "reviewer_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trust": {
      "type": "object",
      "required": [
        "level",
        "challenge_lines",
        "challenge_bytes"
      ],
      "properties": {
        "level": {
          "type": "string"
        },
        "reasons": {
          "type": "array"
        },
        "challenge_lines": {
          "type": "integer"
        },
        "challenge_bytes": {
          "type": "integer"
        }
      }
    },
    "status": {
      "type": "string"
    },
    "registered_at": {
      "type": "string"
    },
    "first_registered_on": {
      "type": "string"
    }
  }
}
