{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/list_error_codes/v2.json",
  "title": "mcp/list_error_codes/v2",
  "description": "The result of the list_error_codes tool (F09-T15; D-28 notation note 2026-10-04). v2 (mcpfix WA2, the owner's ruling of 2026-11-25): by default each code and its meaning in pages; code answers one code's whole row; full: true is GET /errors.json exactly, as v1 answered always. Or an error result naming the source that did not answer, or a code the catalog does not hold (not-found, naming the close codes) (R10).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "count",
        "codes"
      ],
      "properties": {
        "about": {
          "type": "string"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "source",
              "step",
              "meaning",
              "remedy"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "gate",
                  "api",
                  "both"
                ]
              },
              "step": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "meaning": {
                "type": "string"
              },
              "remedy": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "description": "full: true, or one code: GET /errors.json's body, each row whole (with code, the codes matching it exactly)."
    },
    {
      "type": "object",
      "additionalProperties": false,
      "description": "The default: each code with its meaning, in pages (mcpfix WA2).",
      "required": [
        "prefix",
        "count",
        "limit",
        "cursor",
        "next",
        "codes"
      ],
      "properties": {
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "description": "How many codes there are in all (with the prefix).",
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "description": "The most codes this page could hold.",
          "type": "integer",
          "minimum": 1
        },
        "cursor": {
          "description": "Where this page starts, as the call gave it; null for the first page.",
          "type": [
            "string",
            "null"
          ]
        },
        "next": {
          "description": "The cursor of the page after this one; null on the last page.",
          "type": [
            "string",
            "null"
          ]
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "meaning"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ]
}
