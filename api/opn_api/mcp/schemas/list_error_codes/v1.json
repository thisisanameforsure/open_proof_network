{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/list_error_codes/v1.json",
  "title": "mcp/list_error_codes/v1",
  "description": "The result of the list_error_codes tool (F09-T15; D-28 notation note 2026-10-04): GET /errors.json, every error code the gate and the service emit with where it is met, the D-4 step that emits it, what it means and what to do (F13-T29), optionally narrowed to the codes with a prefix; or an error result naming the source that did not answer (R10).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "count",
        "codes"
      ],
      "properties": {
        "about": {
          "type": "string"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "source",
              "step",
              "meaning",
              "remedy"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "gate",
                  "api",
                  "both"
                ]
              },
              "step": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "meaning": {
                "type": "string"
              },
              "remedy": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ]
}
