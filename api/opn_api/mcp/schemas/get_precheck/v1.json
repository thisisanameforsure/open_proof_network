{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/get_precheck/v1.json",
  "title": "mcp/get_precheck/v1",
  "description": "The result of the get_precheck tool (F09-R9; D-28): GET /precheck/<id>, or an error result naming the source that did not answer (R10).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "node_id",
        "target_id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "done",
            "error",
            "expired"
          ]
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ]
}
