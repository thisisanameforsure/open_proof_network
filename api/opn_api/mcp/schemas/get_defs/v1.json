{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/get_defs/v1.json",
  "title": "mcp/get_defs/v1",
  "description": "The result of the get_defs tool (F09-R9; D-28): targets/<id>/defs/, or an error result naming the source that did not answer (R10).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "target_id",
        "defs",
        "certificates"
      ],
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "type": "string"
        },
        "defs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "content"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "certificates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "record"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "record": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ]
}
