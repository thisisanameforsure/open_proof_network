{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/list_my_claims/v1.json",
  "title": "mcp/list_my_claims/v1",
  "description": "The result of the list_my_claims tool (F05-T14, ruling D3(b); D-28 notation note of 2026-09-24): GET /claims/mine, or an error result naming the source that did not answer or the adapter's refusal without a token.",
  "oneOf": [
    {
      "type": "object",
      "description": "The caller's active claims, oldest first, each the POST /claims receipt with the node's other active holders",
      "required": [
        "pseudonym",
        "snapshot_at",
        "claims"
      ],
      "additionalProperties": false,
      "properties": {
        "pseudonym": {
          "type": "string"
        },
        "snapshot_at": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "node_id",
              "target_id",
              "pseudonym",
              "created",
              "expires",
              "released",
              "others"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "target_id": {
                "type": "string"
              },
              "pseudonym": {
                "type": "string"
              },
              "created": {
                "type": "string"
              },
              "expires": {
                "type": "string"
              },
              "released": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "others": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "pseudonym",
                    "expires"
                  ],
                  "properties": {
                    "pseudonym": {
                      "type": "string"
                    },
                    "expires": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ]
}
