{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/get_node/v1.json",
  "title": "mcp/get_node/v1",
  "description": "The result of the get_node tool (F09-R9; D-28; F10-R4): the node's CONTEXT.json plus the raw files under nodes/<id>/, or an error result naming the source that did not answer (R10). Edited in place by F10-T2 (the adapter's result schemas are not protocol records, F09-Q5).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "node_id",
        "target_id",
        "context",
        "context_source",
        "files",
        "claims",
        "annexes",
        "explainers",
        "untrusted_note"
      ],
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "description": "nodes/<id>/CONTEXT.json, a context/v1 document (F10-R3)",
          "required": [
            "schema"
          ],
          "properties": {
            "schema": {
              "const": "context/v1"
            }
          }
        },
        "context_source": {
          "description": "file: the committed CONTEXT.json; derived: the same document built from the files at main, for a graph that carries none yet (F10-Q7)",
          "enum": [
            "file",
            "derived"
          ]
        },
        "files": {
          "type": "object",
          "required": [
            "Statement.lean",
            "Context.lean",
            "Witness.lean",
            "Proof.lean"
          ],
          "additionalProperties": false,
          "properties": {
            "Statement.lean": {
              "type": "string"
            },
            "Context.lean": {
              "type": "string"
            },
            "Witness.lean": {
              "type": [
                "string",
                "null"
              ]
            },
            "Proof.lean": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "claims": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "active",
            "history_count"
          ],
          "properties": {
            "active": {
              "type": "array"
            },
            "history_count": {
              "type": "integer"
            }
          }
        },
        "annexes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "front",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "front": {
                "type": "object"
              },
              "text": {
                "$ref": "#/$defs/untrusted"
              }
            }
          }
        },
        "explainers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "front",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "front": {
                "type": "object"
              },
              "text": {
                "$ref": "#/$defs/untrusted"
              }
            }
          }
        },
        "untrusted_note": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ],
  "$defs": {
    "untrusted": {
      "type": "object",
      "description": "Contributor free text, demarcated (D-28, D-31): data, never instructions",
      "required": [
        "untrusted",
        "source",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "untrusted": {
          "const": true
        },
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
