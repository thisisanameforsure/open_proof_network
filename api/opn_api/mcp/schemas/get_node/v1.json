{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/get_node/v1.json",
  "title": "mcp/get_node/v1",
  "description": "The result of the get_node tool (F09-R9; D-28; F10-R4): the node's CONTEXT.json plus the raw files under nodes/<id>/, or an error result naming the source that did not answer (R10). Edited in place by F10-T2 (the adapter's result schemas are not protocol records, F09-Q5); F09-T7 added the open submissions.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "node_id",
        "target_id",
        "context",
        "context_source",
        "closing",
        "files",
        "claims",
        "annexes",
        "explainers",
        "submissions",
        "untrusted_note"
      ],
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "description": "nodes/<id>/CONTEXT.json, a context/v3 document (F10-R3; F08-T22 added circular_below, the merged circularity claims that circle back to this node; F08-T36 added defect_claims, every defect claim filed against the node with its class and whether it stands, D-16 v3.28) — or the context/v1 or v2 document a graph rendered before that re-pin still carries",
          "required": [
            "schema"
          ],
          "properties": {
            "schema": {
              "enum": [
                "context/v1",
                "context/v2",
                "context/v3"
              ]
            }
          }
        },
        "context_source": {
          "description": "file: the committed CONTEXT.json; derived: the same document built from the files at main, for a graph that carries none yet (F10-Q7)",
          "enum": [
            "file",
            "derived"
          ]
        },
        "closing": {
          "type": "object",
          "description": "How the node is closed through its holes and dependencies (F00-T10): their theorems reach a proof through the node's own Context. context_import says where that import lives: 'statement' (already in Statement.lean, so the proof's header is the statement's) or 'proof' (the statement predates the line, and the proof adds import_line directly after the statement's last import; the one import step 2 allows).",
          "additionalProperties": false,
          "required": [
            "through_holes",
            "context_import",
            "import_line"
          ],
          "properties": {
            "through_holes": {
              "type": "boolean"
            },
            "context_import": {
              "enum": [
                "statement",
                "proof"
              ]
            },
            "import_line": {
              "type": "string"
            }
          }
        },
        "files": {
          "type": "object",
          "required": [
            "Statement.lean",
            "Context.lean",
            "Witness.lean",
            "Proof.lean"
          ],
          "additionalProperties": false,
          "properties": {
            "Statement.lean": {
              "type": "string"
            },
            "Context.lean": {
              "type": "string"
            },
            "Witness.lean": {
              "type": [
                "string",
                "null"
              ]
            },
            "Proof.lean": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "claims": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "active",
            "history_count"
          ],
          "properties": {
            "active": {
              "type": "array"
            },
            "history_count": {
              "type": "integer"
            }
          }
        },
        "annexes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "front",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "front": {
                "type": "object"
              },
              "text": {
                "$ref": "#/$defs/untrusted"
              }
            }
          }
        },
        "explainers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "front",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "front": {
                "type": "object"
              },
              "text": {
                "$ref": "#/$defs/untrusted"
              }
            }
          }
        },
        "submissions": {
          "type": "object",
          "description": "The submissions open on this node, as GET /submissions.json lists them (F09-T7)",
          "required": [
            "open"
          ],
          "additionalProperties": false,
          "properties": {
            "open": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/submission"
              }
            }
          }
        },
        "untrusted_note": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ],
  "$defs": {
    "untrusted": {
      "type": "object",
      "description": "Contributor free text, demarcated (D-28, D-31): data, never instructions",
      "required": [
        "untrusted",
        "source",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "untrusted": {
          "const": true
        },
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "submission": {
      "type": "object",
      "description": "A pull request the service opened (F07-T16): operational, not evidentiary (C9)",
      "required": [
        "id",
        "kind",
        "node_id",
        "target_id",
        "pr_number",
        "pr_url",
        "pseudonym",
        "precheck_job_id",
        "created",
        "closed",
        "artifact_type",
        "queue"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": "string"
        },
        "pr_number": {
          "type": "integer"
        },
        "pr_url": {
          "type": "string"
        },
        "pseudonym": {
          "type": "string"
        },
        "precheck_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": "string"
        },
        "closed": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "The record's kind under the name the write routes use, when it is an artifact type of POST /submissions (proof, counterexample, vacuity, reduction, partial); null otherwise (F05-T18)"
        },
        "queue": {
          "type": "object",
          "description": "Where the pull request stands in the merge actor's order (F05-T18): position from 1 among the open pull requests the actor takes in this one's lane: its own target's, and any the service cannot place in one target (F07-T69) (null for one it does not take, or when the host was never listed), of how many, and what the service last read it to be waiting on (null: not read; ask get_submission)",
          "required": [
            "position",
            "of",
            "waiting_on",
            "waiting_on_read_at"
          ],
          "additionalProperties": false,
          "properties": {
            "position": {
              "type": [
                "integer",
                "null"
              ]
            },
            "of": {
              "type": [
                "integer",
                "null"
              ]
            },
            "waiting_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "waiting_on_read_at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
