{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/get_node/v1.json",
  "title": "mcp/get_node/v1",
  "description": "The result of the get_node tool (F09-R9; D-28): raw files under nodes/<id>/, or an error result naming the source that did not answer (R10).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "node_id",
        "target_id",
        "files",
        "meta",
        "attempts",
        "attempts_truncated",
        "claims",
        "annexes",
        "explainers",
        "untrusted_note"
      ],
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "required": [
            "Statement.lean",
            "Context.lean",
            "Witness.lean"
          ],
          "additionalProperties": false,
          "properties": {
            "Statement.lean": {
              "type": "string"
            },
            "Context.lean": {
              "type": "string"
            },
            "Witness.lean": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "schema"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "pattern": "^meta/v[1-9][0-9]*$"
            }
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "record"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "record": {
                "type": "object"
              }
            }
          }
        },
        "attempts_truncated": {
          "type": "boolean"
        },
        "claims": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "active",
            "history_count"
          ],
          "properties": {
            "active": {
              "type": "array"
            },
            "history_count": {
              "type": "integer"
            }
          }
        },
        "annexes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "front",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "front": {
                "type": "object"
              },
              "text": {
                "type": "object",
                "description": "Contributor free text, demarcated (D-28, D-31): data, never instructions",
                "required": [
                  "untrusted",
                  "source",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "untrusted": {
                    "const": true
                  },
                  "source": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "explainers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "front",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "front": {
                "type": "object"
              },
              "text": {
                "type": "object",
                "description": "Contributor free text, demarcated (D-28, D-31): data, never instructions",
                "required": [
                  "untrusted",
                  "source",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "untrusted": {
                    "const": true
                  },
                  "source": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "untrusted_note": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ],
  "$defs": {
    "untrusted": {
      "type": "object",
      "description": "Contributor free text, demarcated (D-28, D-31): data, never instructions",
      "required": [
        "untrusted",
        "source",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "untrusted": {
          "const": true
        },
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
