{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/list_submissions/v1.json",
  "title": "mcp/list_submissions/v1",
  "description": "The result of the list_submissions tool (F09-R9, F09-T7; D-28 notation note of 2026-09-14): GET /submissions.json, or an error result naming the source that did not answer (R10). Reshaped in place by F07-T47 (host: when the queue was reconciled, and whether that is stale). F05-T18 added queue, and each entry's queue and artifact_type; the entries are in queue order.",
  "oneOf": [
    {
      "type": "object",
      "description": "The open pull requests the service opened, each the submission document GET /submissions/<id> carries",
      "required": [
        "snapshot_at",
        "open",
        "host",
        "queue"
      ],
      "additionalProperties": false,
      "properties": {
        "snapshot_at": {
          "type": "string"
        },
        "open": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/submission"
          }
        },
        "host": {
          "type": "object",
          "description": "The host listing the queue was reconciled against (F07-T47): when it was read, whether it is the last one the host gave, and why when it is",
          "required": [
            "read_at",
            "stale",
            "error"
          ],
          "additionalProperties": false,
          "properties": {
            "read_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "stale": {
              "type": "boolean"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "queue": {
          "type": "object",
          "description": "The merge actor's order over the open pull requests (F05-T18): their numbers, how the order is to be read, and what an entry's queue.waiting_on means",
          "required": [
            "order",
            "description",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "order": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer"
              }
            },
            "description": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ],
  "$defs": {
    "submission": {
      "type": "object",
      "description": "A pull request the service opened (F07-T16): operational, not evidentiary (C9)",
      "required": [
        "id",
        "kind",
        "node_id",
        "target_id",
        "pr_number",
        "pr_url",
        "pseudonym",
        "precheck_job_id",
        "created",
        "closed",
        "artifact_type",
        "queue"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": "string"
        },
        "pr_number": {
          "type": "integer"
        },
        "pr_url": {
          "type": "string"
        },
        "pseudonym": {
          "type": "string"
        },
        "precheck_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": "string"
        },
        "closed": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "The record's kind under the name the write routes use, when it is an artifact type of POST /submissions (proof, counterexample, vacuity, reduction, partial); null otherwise (F05-T18)"
        },
        "queue": {
          "type": "object",
          "description": "Where the pull request stands in the merge actor's order (F05-T18): position from 1 among the open pull requests the actor takes (null for one it does not take, or when the host was never listed), of how many, and what the service last read it to be waiting on (null: not read; ask get_submission)",
          "required": [
            "position",
            "of",
            "waiting_on",
            "waiting_on_read_at"
          ],
          "additionalProperties": false,
          "properties": {
            "position": {
              "type": [
                "integer",
                "null"
              ]
            },
            "of": {
              "type": [
                "integer",
                "null"
              ]
            },
            "waiting_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "waiting_on_read_at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
