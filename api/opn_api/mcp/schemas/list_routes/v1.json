{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/list_routes/v1.json",
  "title": "mcp/list_routes/v1",
  "description": "The result of the list_routes tool (F09-R9; D-28 notation note 2026-09-20): GET /, the service's route index, or an error result naming the source that did not answer (R10).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "service",
        "routes"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "guide": {
          "type": [
            "string",
            "null"
          ]
        },
        "mcp": {
          "type": [
            "string",
            "null"
          ]
        },
        "authoritative_for": {},
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "method",
              "path",
              "auth",
              "purpose"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "auth": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ]
}
