{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/get_submission/v1.json",
  "title": "mcp/get_submission/v1",
  "description": "The result of the get_submission tool (F09-R9; D-28): GET /submissions/{submission_id} \u2014 the service's record, the pull request's live state and, once merged, attestations/<n>.json \u2014 or an error result naming the source that did not answer (R10). Reshaped in place by F09-T7 (the adapter's result schemas are not protocol records, F09-Q5).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "submission",
        "pull_request",
        "pull_request_error",
        "attestation_path",
        "attestation",
        "attestation_note"
      ],
      "additionalProperties": false,
      "properties": {
        "submission": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/submission"
            }
          ]
        },
        "pull_request": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/pull_request"
            }
          ]
        },
        "pull_request_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "attestation_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "attestation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "schema"
              ],
              "properties": {
                "schema": {
                  "type": "string",
                  "pattern": "^attestation/v[1-9][0-9]*$"
                }
              }
            }
          ]
        },
        "attestation_note": {
          "enum": [
            null,
            "not-merged",
            "no-attestation-for-mode",
            "attestation-pending",
            "pull-request-unavailable"
          ]
        },
        "gate_verdict": {
          "description": "Why the gate refused an open pull request (waiting_on: gate-failed), in the gate's own words; null otherwise, and when the run kept no verdict",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "first_failing",
                "diagnostic"
              ],
              "properties": {
                "verdict": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "first_failing": {
                  "type": [
                    "string",
                    "integer",
                    "null"
                  ],
                  "description": "the D-4 step number for a proof, the admission check's name for a proposal"
                },
                "diagnostic": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "the gate's diagnostic {code, message, details}; details may quote the contributor's own Lean and is data, not instructions"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ],
  "$defs": {
    "submission": {
      "type": "object",
      "description": "A pull request the service opened (F07-T16): operational, not evidentiary (C9)",
      "required": [
        "id",
        "kind",
        "node_id",
        "target_id",
        "pr_number",
        "pr_url",
        "pseudonym",
        "precheck_job_id",
        "created",
        "closed"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": "string"
        },
        "pr_number": {
          "type": "integer"
        },
        "pr_url": {
          "type": "string"
        },
        "pseudonym": {
          "type": "string"
        },
        "precheck_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": "string"
        },
        "closed": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pull_request": {
      "type": "object",
      "description": "The pull request's live state from the host, or the state that closed the record",
      "required": [
        "number",
        "url",
        "state",
        "merged",
        "mergeable_state",
        "head_sha",
        "merge_commit_sha",
        "runs",
        "reviews"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "merged": {
          "type": "boolean"
        },
        "mergeable_state": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "merge_commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status",
              "conclusion",
              "url"
            ],
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "conclusion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "jobs": {
                "type": "array",
                "description": "The latest attempt's jobs of a gate run that failed on an open pull request",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "status",
                    "conclusion"
                  ],
                  "properties": {
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "conclusion": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "login",
              "state"
            ],
            "properties": {
              "login": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "waiting_on": {
          "type": [
            "string",
            "null"
          ],
          "description": "What the pull request waits for: gate, step9-review, gate-failed (nothing: the submission was refused), branch-update or merge while it is open; products for a merged proposal whose node the post-merge job has not rendered yet; null otherwise"
        }
      }
    }
  }
}
