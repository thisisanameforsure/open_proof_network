{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openproof.network/schemas/mcp/list_sufficient_sets/v1.json",
  "title": "mcp/list_sufficient_sets/v1",
  "description": "The result of the list_sufficient_sets tool (F27-T2, R9; D-25, D-28 v3.40): a target's routes, each merged decomposition with its holes' facts aggregated, and its sufficient sets, each a set of statements whose proofs with the closing proofs of its assemblies would close the root; derived by opn_gate.routes.read from targets/<id>/graph.json at main and the served frontier.json, in the record's order: nothing is ranked (D-25). Every value is an id, a count, an enum or a frontier timestamp, so nothing is demarcated. Or an error result naming the source that did not answer, or the arguments refused (R10).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_at",
        "target_id",
        "root",
        "cut",
        "truncated",
        "routes",
        "sets"
      ],
      "properties": {
        "read_at": {
          "description": "The commit of main the graph was read at, or the branch name when the service could not learn its head (F05-T13).",
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "cut": {
          "enum": [
            "finest",
            "any"
          ]
        },
        "truncated": {
          "description": "The enumeration reached the service's cap (OPN_API_ROUTES_MAX_SETS).",
          "type": "boolean"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "node",
              "partial",
              "resolved",
              "live",
              "holes",
              "summary"
            ],
            "properties": {
              "id": {
                "description": "<node>@<k>: the node's k-th merged decomposition in the record's order.",
                "type": "string"
              },
              "node": {
                "type": "string"
              },
              "partial": {
                "type": "string"
              },
              "resolved": {
                "description": "Every hole names its node.",
                "type": "boolean"
              },
              "live": {
                "description": "Resolved, and no hole refuted, defective, abandoned or superseded.",
                "type": "boolean"
              },
              "holes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "node",
                    "status",
                    "attempts",
                    "refuted_route_classes",
                    "ready_since",
                    "routes"
                  ],
                  "properties": {
                    "name": {
                      "description": "The hole's name in the partial.",
                      "type": "string"
                    },
                    "node": {
                      "description": "The node the hole became, read through revisions; null when the record does not say and F27-R2 could not assign one.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "description": "The node's derived status as graph.json carries it; null when the hole names no node.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "attempts": {
                      "description": "The frontier entry's attempt count; null when the node is not on the frontier.",
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "refuted_route_classes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "ready_since": {
                      "description": "The frontier entry's ready_since, repeated.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "routes": {
                      "description": "How many routes of its own the hole's node has.",
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "summary": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "holes",
                  "proved",
                  "open",
                  "dead",
                  "unresolved",
                  "attempts",
                  "unattempted",
                  "refuted_route_classes",
                  "oldest_open_since"
                ],
                "properties": {
                  "holes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "proved": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "open": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "dead": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unresolved": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "attempts": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Attempts recorded on the route's open holes the frontier lists."
                  },
                  "unattempted": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Open holes the frontier lists with no attempt."
                  },
                  "refuted_route_classes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "oldest_open_since": {
                    "description": "The earliest ready_since among the route's open holes; null when none is ready.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "sets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statements",
              "proved",
              "open",
              "assemblies",
              "routes",
              "variant",
              "total",
              "closed",
              "remaining",
              "shared",
              "circular"
            ],
            "properties": {
              "id": {
                "description": "s- and ten hex digits of the sha256 of the set's statements and assemblies.",
                "type": "string"
              },
              "statements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "proved": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "open": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assemblies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Interior nodes the set's routes pass through, each still needing its closing proof (D-12 v3.19)."
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The routes the set uses, the root's first."
              },
              "variant": {
                "description": "The resolves variant the set goes through, or null.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "closed": {
                "type": "integer",
                "minimum": 0
              },
              "remaining": {
                "type": "integer",
                "minimum": 0
              },
              "shared": {
                "description": "How many of its statements another set also holds.",
                "type": "integer",
                "minimum": 0
              },
              "circular": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Its statements carrying a circularity label (D-12 v3.35): shown, never removed."
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "description": "The plain path did not answer, or the arguments were refused (F09-R10)",
      "required": [
        "error",
        "message",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "enum": [
            "graph",
            "service",
            "adapter"
          ]
        },
        "status": {
          "type": "integer"
        }
      }
    }
  ]
}
